diff --git a/src/components/ReviewRepliesPanel.tsx b/src/components/ReviewRepliesPanel.tsx
new file mode 100644
index 0000000..9876fdd
--- /dev/null
+++ b/src/components/ReviewRepliesPanel.tsx
@@ -0,0 +1,190 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+/**
+ * پنل پاسخ به نظرات مشتریان — هم برای سالن‌دار (پیش‌فرض) و هم برای سوپرادمین
+ * (با پاس کردن listPath/patchPath متغیر). منطق دسترسی سمت سرور بررسی می‌شود.
+ */
+
+type OwnerReview = {
+  id: string;
+  rating: number;
+  comment?: string | null;
+  customerName?: string | null;
+  staff?: { name: string } | string | null;
+  reply?: string | null;
+  repliedAt?: string | null;
+  createdAt: string;
+  customer?: { name?: string | null; phone?: string | null } | null;
+  salon?: { name: string; slug: string } | null;
+};
+
+type Msg = { ok: boolean; text: string } | null;
+
+export default function ReviewRepliesPanel({
+  salonId,
+  listUrl,
+  patchUrl,
+  listPath = "reviews",
+  patchPath = "reviews",
+  showSalon = false,
+}: {
+  salonId?: string;
+  /** برای سوپرادمین: مسیر آمادهٔ فهرست/پاسخ (مثل /api/admin/reviews) */
+  listUrl?: string;
+  patchUrl?: string;
+  listPath?: string;
+  patchPath?: string;
+  showSalon?: boolean;
+}) {
+  const [reviews, setReviews] = useState<OwnerReview[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [msg, setMsg] = useState<Msg>(null);
+  const [openFor, setOpenFor] = useState<string | null>(null);
+  const [draft, setDraft] = useState("");
+  const [saving, setSaving] = useState(false);
+
+  const finalListUrl = listUrl ?? (salonId ? `/api/dashboard/salons/${salonId}/${listPath}` : "/api/admin/reviews");
+  const finalPatchUrl = patchUrl ?? (salonId ? `/api/dashboard/salons/${salonId}/${patchPath}` : "/api/admin/reviews");
+
+  useEffect(() => {
+    let cancelled = false;
+    fetch(finalListUrl)
+      .then((r) => r.json())
+      .then((d) => {
+        if (!cancelled && d.success) setReviews((d.reviews as OwnerReview[]) ?? []);
+      })
+      .catch(() => {})
+      .finally(() => {
+        if (!cancelled) setLoading(false);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [finalListUrl]);
+
+  async function sendReply(id: string, reply: string) {
+    if (saving) return;
+    setSaving(true);
+    try {
+      const res = await fetch(finalPatchUrl, {
+        method: "PATCH",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ reviewId: id, reply }),
+      });
+      const data = await res.json();
+      if (!data.success) {
+        setMsg({ ok: false, text: data.error || "خطا در ثبت پاسخ" });
+        return;
+      }
+      const updated = data.review as { reply: string | null; repliedAt: string | null };
+      setReviews((prev) => prev.map((r) => (r.id === id ? { ...r, ...updated } : r)));
+      setMsg({ ok: true, text: reply.trim() ? "پاسخ ثبت شد ✅" : "پاسخ حذف شد" });
+      setOpenFor(null);
+      setDraft("");
+    } catch {
+      setMsg({ ok: false, text: "خطا در ارتباط با سرور" });
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  function startEdit(r: OwnerReview) {
+    setOpenFor(r.id);
+    setDraft(r.reply ?? "");
+  }
+
+  return (
+    <div className="space-y-3">
+      {msg && (
+        <p className={`rounded-xl px-4 py-2.5 text-sm ${msg.ok ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300" : "bg-red-50 text-red-600 dark:bg-red-900/30 dark:text-red-300"}`}>
+          {msg.text}
+        </p>
+      )}
+
+      {loading ? (
+        <p className="py-6 text-center text-sm text-neutral-400">در حال بارگیری نظرات...</p>
+      ) : reviews.length === 0 ? (
+        <p className="py-6 text-center text-sm text-neutral-400 dark:text-neutral-500">هنوز نظری ثبت نشده است.</p>
+      ) : (
+        reviews.map((r) => {
+          const customer = r.customerName ?? r.customer?.name ?? r.customer?.phone ?? "مشتری";
+          const staffName = typeof r.staff === "string" ? r.staff : r.staff?.name ?? null;
+          const isOpen = openFor === r.id;
+          return (
+            <div key={r.id} className="rounded-2xl border border-neutral-200 bg-white px-4 py-3.5 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
+              <div className="flex flex-wrap items-start justify-between gap-2">
+                <div className="min-w-0">
+                  <div className="font-bold text-neutral-800 dark:text-neutral-100">
+                    {customer} <span className="text-amber-500">★ {r.rating}</span>
+                    {staffName && <span className="text-xs font-normal text-neutral-400"> — {staffName}</span>}
+                  </div>
+                  {showSalon && r.salon?.name && (
+                    <div className="text-[11px] text-neutral-400">سالن: {r.salon.name}</div>
+                  )}
+                  <div className="text-[11px] text-neutral-400">{new Date(r.createdAt).toLocaleDateString("fa-IR")}</div>
+                </div>
+                {!isOpen && (
+                  <button
+                    onClick={() => startEdit(r)}
+                    className={`h-9 shrink-0 rounded-lg px-3 text-xs font-bold transition ${
+                      r.reply
+                        ? "bg-neutral-100 text-neutral-600 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700"
+                        : "bg-gradient-to-l from-pink-600 to-purple-600 text-white hover:opacity-90"
+                    }`}
+                  >
+                    {r.reply ? "ویرایش پاسخ" : "پاسخ"}
+                  </button>
+                )}
+              </div>
+
+              {r.comment && <p className="mt-1.5 text-sm text-neutral-600 dark:text-neutral-300">{r.comment}</p>}
+
+              {r.reply && !isOpen && (
+                <div className="mt-2 rounded-xl border-r-4 border-pink-500 bg-pink-50/70 px-3 py-2 text-sm dark:bg-pink-950/30">
+                  <div className="mb-0.5 text-[11px] font-black text-pink-600 dark:text-pink-300">
+                    پاسخ {showSalon ? "پشتیبانی" : "سالن"}
+                    {r.repliedAt && <span className="mr-1.5 font-normal text-neutral-400">{new Date(r.repliedAt).toLocaleDateString("fa-IR")}</span>}
+                  </div>
+                  <p className="text-neutral-700 dark:text-neutral-200">{r.reply}</p>
+                </div>
+              )}
+
+              {isOpen && (
+                <div className="mt-2.5 space-y-2">
+                  <textarea
+                    value={draft}
+                    onChange={(e) => setDraft(e.target.value)}
+                    rows={3}
+                    maxLength={1000}
+                    placeholder="پاسخ شما به این نظر… (حداکثر ۱۰۰۰ نویسه؛ برای حذف پاسخ، متن را خالی بگذارید)"
+                    className="w-full rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-800 outline-none transition focus:border-pink-400 focus:ring-2 focus:ring-pink-100 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100 dark:focus:ring-pink-900/40"
+                  />
+                  <div className="flex items-center gap-2">
+                    <button
+                      onClick={() => sendReply(r.id, draft)}
+                      disabled={saving}
+                      className="h-9 rounded-lg bg-gradient-to-l from-pink-600 to-purple-600 px-4 text-xs font-bold text-white transition hover:opacity-90 disabled:opacity-50"
+                    >
+                      {saving ? "در حال ثبت..." : "ثبت پاسخ"}
+                    </button>
+                    <button
+                      onClick={() => {
+                        setOpenFor(null);
+                        setDraft("");
+                      }}
+                      className="h-9 rounded-lg bg-neutral-100 px-3 text-xs font-bold text-neutral-600 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300"
+                    >
+                      انصراف
+                    </button>
+                  </div>
+                </div>
+              )}
+            </div>
+          );
+        })
+      )}
+    </div>
+  );
+}
