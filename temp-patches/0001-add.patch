+++ b/src/lib/map-links.ts
@@ -0,0 +1,54 @@
+/**
+ * لینک‌های عمیق نقشهٔ نشان و بلد.
+ * فرمت‌ها مستقیماً از سرویس‌ها بررسی و تأیید شده‌اند:
+ *  - نشان (مختصات): https://neshan.org/maps/share/{lat},{lng}  (همان مسیری که nsh.link ریدایرکت می‌کند)
+ *  - نشان (جست‌وجو): https://neshan.org/maps/search/{query}
+ *  - بلد (مختصات):  https://balad.ir/#{zoom}/{lat}/{lng}       (هش نقشهٔ وب بلد)
+ *  - بلد (جست‌وجو):  https://balad.ir/search?text={query}
+ * سالن‌هایی که هنوز مختصات ثبت نکرده‌اند با جست‌وجوی آدرس باز می‌شوند.
+ */
+
+export type MapCoords = { latitude: number; longitude: number };
+
+const BALAD_ZOOM = 16;
+
+/** مختصات معتبر جغرافیایی؟ (مقدارهای NaN/بی‌کران و بازه‌های نامعتبر رد می‌شوند) */
+function isValidCoords(c: MapCoords | null | undefined): c is MapCoords {
+  return (
+    !!c &&
+    Number.isFinite(c.latitude) &&
+    Number.isFinite(c.longitude) &&
+    Math.abs(c.latitude) <= 90 &&
+    Math.abs(c.longitude) <= 180
+  );
+}
+
+/** شش رقم اعشا برای پایداری URL (بدون نماد علمی) */
+function fmt(n: number): string {
+  return n.toFixed(6);
+}
+
+/** رشتهٔ جست‌وجوی امن از نام/شهر/آدرس؛ اگر آدرس با نام شهر شروع شود، شهر تکراری حذف می‌شود */
+export function mapSearchQuery(name: string, city?: string | null, address?: string | null): string {
+  const n = (name ?? "").trim();
+  let c = (city ?? "").trim();
+  const a = (address ?? "").trim();
+  if (c && a && (a === c || a.startsWith(`${c}،`) || a.startsWith(`${c},`) || a.startsWith(`${c} `))) c = "";
+  return [n, c, a].filter(Boolean).join(" ");
+}
+
+/** لینک نشان: با مختصات → پین روی نقشه؛ بدون مختصات → جست‌وجوی آدرس */
+export function neshanMapUrl(coords: MapCoords | null | undefined, query: string): string {
+  if (isValidCoords(coords)) {
+    return `https://neshan.org/maps/share/${fmt(coords.latitude)},${fmt(coords.longitude)}`;
+  }
+  return `https://neshan.org/maps/search/${encodeURIComponent(query.trim())}`;
+}
+
+/** لینک بلد: با مختصات → مرکز نقشه؛ بدون مختصات → جست‌وجوی آدرس */
+export function baladMapUrl(coords: MapCoords | null | undefined, query: string): string {
+  if (isValidCoords(coords)) {
+    return `https://balad.ir/#${BALAD_ZOOM}/${fmt(coords.latitude)}/${fmt(coords.longitude)}`;
+  }
+  return `https://balad.ir/search?text=${encodeURIComponent(query.trim())}`;
+}
diff --git a/src/lib/notifications/fa.ts b/src/lib/notifications/fa.ts
new file mode 100644
index 0000000..801c7a8
--- /dev/null
+++ b/src/lib/notifications/fa.ts
@@ -0,0 +1,220 @@
+/**
+ * فارسی‌سازی برچسب‌ها و متن‌های فنی اعلان‌ها/پیامک‌ها برای پنل سوپرادمین.
+ * مقادیر دیتابیس (type/channel/status/خطاهای سرویس‌ها) انگلیسی می‌مانند و
+ * فقط در نمایش ترجمه می‌شوند.
+ */
+
+export const NOTIF_TYPE_LABELS: Record<string, string> = {
+  OTP: "کد تأیید ورود",
+  APPOINTMENT_CONFIRM: "تأیید نوبت",
+  APPOINTMENT_STATUS: "وضعیت نوبت",
+  APPOINTMENT_CANCEL: "لغو نوبت",
+  APPOINTMENT_CHANGED: "جابه‌جایی نوبت",
+  REMINDER: "یادآوری نوبت",
+  WAITLIST_FREED: "آزاد شدن صف انتظار",
+  SUBSCRIPTION: "اشتراک",
+  SUBSCRIPTION_ACTIVATED: "فعال‌سازی اشتراک",
+  SUBSCRIPTION_RENEWED: "تمدید اشتراک",
+  SUBSCRIPTION_EXPIRED: "اتمام اشتراک",
+  SUBSCRIPTION_RENEWAL_REMINDER: "یادآوری تمدید",
+  SUBSCRIPTION_PAYMENT_FAILED: "شکست پرداخت اشتراک",
+  INVOICE_PAY_LINK: "لینک پرداخت فاکتور",
+  SMS_LIMIT_REACHED: "اتمام سقف پیامک",
+  SUPPORT_REPLY: "پاسخ پشتیبانی",
+  BROADCAST: "پیام انبوه",
+  MARKETING: "کمپین تبلیغاتی",
+  TXT: "پیام متنی",
+};
+
+export function notifTypeLabel(type: string): string {
+  return NOTIF_TYPE_LABELS[type] ?? type;
+}
+
+export type BadgeMeta = { label: string; cls: string; dot: string };
+
+export const NOTIF_STATUS_META: Record<string, BadgeMeta> = {
+  PENDING: {
+    label: "در صف ارسال",
+    cls: "bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-400/20",
+    dot: "bg-amber-500",
+  },
+  SENT: {
+    label: "ارسال‌شده",
+    cls: "bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-950/40 dark:text-emerald-300 dark:ring-emerald-400/20",
+    dot: "bg-emerald-500",
+  },
+  FAILED: {
+    label: "ناموفق",
+    cls: "bg-red-50 text-red-700 ring-red-600/20 dark:bg-red-950/40 dark:text-red-300 dark:ring-red-400/20",
+    dot: "bg-red-500",
+  },
+  DROPPED: {
+    label: "از صف خارج شد",
+    cls: "bg-neutral-100 text-neutral-600 ring-neutral-500/20 dark:bg-neutral-800 dark:text-neutral-300 dark:ring-neutral-500/25",
+    dot: "bg-neutral-400",
+  },
+};
+
+export const NOTIF_CHANNEL_META: Record<string, { label: string; icon: string }> = {
+  SMS: { label: "پیامک", icon: "💬" },
+  EMAIL: { label: "ایمیل", icon: "✉️" },
+  IN_APP: { label: "درون‌برنامه‌ای", icon: "🔔" },
+};
+
+export function notifStatusMeta(status: string): BadgeMeta {
+  return NOTIF_STATUS_META[status] ?? {
+    label: status,
+    cls: "bg-neutral-100 text-neutral-600 ring-neutral-500/20 dark:bg-neutral-800 dark:text-neutral-300",
+    dot: "bg-neutral-400",
+  };
+}
+
+export function notifChannelLabel(channel: string): string {
+  return NOTIF_CHANNEL_META[channel]?.label ?? channel;
+}
+
+const ERROR_PATTERNS: { re: RegExp; fa: (m: RegExpMatchArray) => string }[] = [
+  { re: /^SMS HTTP (\d+)/i, fa: (m) => `پاسخ سرویس پیامک: خطای ${m[1]}` },
+  { re: /invalid.*(api.?key|token|secret)/i, fa: () => "کلید API نامعتبر است" },
+  { re: /(wrong|invalid|incorrect).*(password|login|credential)/i, fa: () => "نام کاربری یا رمز سرویس اشتباه است" },
+  { re: /(not.?authenticated|unauthorized|permission)/i, fa: () => "مجوز دسترسی به سرویس پیامک وجود ندارد" },
+  { re: /(insufficient|not enough|invalid credit|credit)/i, fa: () => "اعتبار پنل پیامک کافی نیست" },
+  { re: /(blacklist|banned|spam)/i, fa: () => "خط در لیست سیاه سرویس پیامک است" },
+  { re: /(invalid|wrong).*(mobile|phone|number|recipient)/i, fa: () => "شماره گیرنده معتبر نیست" },
+  { re: /(ip|allowed ip|whitelist)/i, fa: () => "IP سرور در فهرست مجاز سرویس پیامک نیست" },
+  { re: /(timeout|timed out|ETIMEDOUT|ESOCKETTIMEDOUT)/i, fa: () => "اتمام زمان انتظار سرویس پیامک" },
+  { re: /(ENOTFOUND|ECONNREFUSED|ECONNRESET|network|fetch failed|socket)/i, fa: () => "خطای اتصال شبکه به سرویس پیامک" },
+  { re: /(rate|too many|limit)/i, fa: () => "سقف تعداد ارسال سرویس پیامک پر شده است" },
+  { re: /(empty|invalid).*(sender|from)/i, fa: () => "شماره خط فرستنده در تنظیمات سرویس پیامک نامعتبر است" },
+  { re: /(sms|message).*(not send|failed|error)/i, fa: () => "ارسال پیامک در سرویس ناموفق بود" },
+  { re: /(duplicate|already)/i, fa: () => "این پیام قبلاً ارسال شده است" },
+];
+
+/**
+ * ترجمهٔ خطاهای رایج سرویس‌های پیامک به فارسی؛ اگر الگوشناختی نبود، متن
+ * اصلی نگه داشته می‌شود تا برای پیگیری خطاهای فنی قابل خواندن بماند.
+ */
+export function localizeNotifError(err?: string | null): string {
+  if (!err) return "";
+  const text = String(err).trim();
+  for (const { re, fa } of ERROR_PATTERNS) {
+    const m = text.match(re);
+    if (m) return fa(m);
+  }
+  return text;
+}
+
+/** فاصلهٔ زمانی فارسی (مثل «۱۲ دقیقه پیش») */
+export function faTimeAgo(iso: string | Date): string {
+  const t = new Date(iso).getTime();
+  if (Number.isNaN(t)) return "";
+  const diff = Math.max(0, Date.now() - t);
+  const min = Math.floor(diff / 60000);
+  if (min < 1) return "هم‌اکنون";
+  if (min < 60) return `${faNum(min)} دقیقه پیش`;
+  const h = Math.floor(min / 60);
+  if (h < 24) return `${faNum(h)} ساعت پیش`;
+  const d = Math.floor(h / 24);
+  if (d < 30) return `${faNum(d)} روز پیش`;
+  return faDate(iso);
+}
+
+const FA_DIGITS = "۰۱۲۳۴۵۶۷۸۹";
+
+/** عدد به رقم فارسی */
+export function faNum(n: number | string): string {
+  return String(n).replace(/\d/g, (d) => FA_DIGITS[Number(d)]);
+}
+
+/**
+ * سازنده‌های Intl گران‌اند و جدول گزارش تا ۵۰۰ ردیف را رندر می‌کند؛ بنابراین
+ * formatterها یک‌بار ساخته و نتیجهٔ هر لحظه در حافظهٔ کوچک می‌ماند.
+ */
+let fmtDate: Intl.DateTimeFormat | null = null;
+let fmtTime: Intl.DateTimeFormat | null = null;
+let fmtFull: Intl.DateTimeFormat | null = null;
+const dateCache = new Map<string, string>();
+const fullCache = new Map<string, string>();
+
+function cacheSet(map: Map<string, string>, key: string, value: string): void {
+  if (map.size > 4000) map.clear();
+  map.set(key, value);
+}
+
+/** تاریخ و ساعت کامل شمسی (۱۴۰۵/۰۸/۰۹ ۱۴:۵۵) */
+export function faDate(iso: string | Date): string {
+  const key = typeof iso === "string" ? iso : iso.toISOString();
+  const hit = dateCache.get(key);
+  if (hit !== undefined) return hit;
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return "";
+  fmtDate ??= new Intl.DateTimeFormat("fa-IR", { year: "numeric", month: "2-digit", day: "2-digit" });
+  fmtTime ??= new Intl.DateTimeFormat("fa-IR", { hour: "2-digit", minute: "2-digit", hour12: false });
+  const out = `${fmtDate.format(d)} ${fmtTime.format(d)}`;
+  cacheSet(dateCache, key, out);
+  return out;
+}
+
+/** تاریخ و ساعت شمسی با نام روز (برای ردیف جزئیات) */
+export function faDateFull(iso: string | Date): string {
+  const key = typeof iso === "string" ? iso : iso.toISOString();
+  const hit = fullCache.get(key);
+  if (hit !== undefined) return hit;
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return "";
+  fmtFull ??= new Intl.DateTimeFormat("fa-IR", {
+    weekday: "long",
+    day: "numeric",
+    month: "long",
+    year: "numeric",
+    hour: "2-digit",
+    minute: "2-digit",
+  });
+  const out = fmtFull.format(d);
+  cacheSet(fullCache, key, out);
+  return out;
+}
+
+/**
+ * فاصلهٔ زمانی تا یک لحظهٔ آینده (مثل «۲۳ دقیقه دیگر»). برای زمان‌های گذشته
+ * همان «… پیش» برگردانده می‌شود و برای زمانِ رسیده «هم‌اکنون».
+ */
+export function faTimeUntil(iso: string | Date): string {
+  const t = new Date(iso).getTime();
+  if (Number.isNaN(t)) return "";
+  const diff = t - Date.now();
+  if (diff <= 30_000) return "هم‌اکنون";
+  const min = Math.round(diff / 60_000);
+  if (min < 60) return `${faNum(min)} دقیقه دیگر`;
+  const h = Math.floor(min / 60);
+  const rest = min % 60;
+  if (h < 24) return rest ? `${faNum(h)} ساعت و ${faNum(rest)} دقیقه دیگر` : `${faNum(h)} ساعت دیگر`;
+  const d = Math.floor(h / 24);
+  return `${faNum(d)} روز دیگر`;
+}
+
+/**
+ * متن پیامی که در صف ثبت شده (پیامک/درون‌برنامه‌ای: `message`، ایمیل: `subject`).
+ * payload در دیتابیس JSON است و ممکن است رشتهٔ خام JSON هم باشد.
+ */
+export function notifBodyText(payload: unknown, channel?: string): string {
+  let data: unknown = payload;
+  if (typeof data === "string") {
+    const raw = data;
+    try {
+      data = JSON.parse(raw);
+    } catch {
+      return channel === "EMAIL" ? "" : raw;
+    }
+  }
+  if (!data || typeof data !== "object") return "";
+  const rec = data as Record<string, unknown>;
+  const subject = typeof rec.subject === "string" ? rec.subject.trim() : "";
+  const message = typeof rec.message === "string" ? rec.message.trim() : "";
+  if (channel === "EMAIL") return subject;
+  return message || subject;
+}
+
+/** سقف تلاش‌های صف پیش از خارج شدن پیامک از صف (هم‌راستا با MAX_ATTEMPTS در queue.ts) */
+export const MAX_SMS_ATTEMPTS = 5;
+
diff --git a/src/lib/reviews.ts b/src/lib/reviews.ts
new file mode 100644
index 0000000..03640b9
--- /dev/null
+++ b/src/lib/reviews.ts
@@ -0,0 +1,88 @@
+import { z } from "zod";
+import { prisma } from "@/lib/prisma";
+import { requireRole, requireSalonManage } from "@/lib/auth/guards";
+import { logAudit } from "@/lib/audit";
+import { httpError } from "@/lib/utils";
+
+export const reviewReplySchema = z.object({
+  reviewId: z.string().min(1),
+  reply: z.string().trim().max(1000).optional(),
+});
+
+export type ReviewReplyInput = z.infer<typeof reviewReplySchema>;
+
+/**
+ * ثبت یا ویرایش پاسخ به نظر مشتری.
+ * فقط سوپرادمین (هر نظری) و مالک سالن مربوطه می‌توانند پاسخ دهند؛
+ * بررسی مالکیت حتماً سمت سرور انجام می‌شود (tenant isolation).
+ * با reply خالی/بدون مقدار، پاسخ قبلی حذف می‌شود.
+ */
+export async function setReviewReplyForAdmin(input: ReviewReplyInput) {
+  const user = await requireRole(["ADMIN"]);
+  const before = await prisma.review.findUnique({
+    where: { id: input.reviewId },
+    select: { id: true, reply: true, salonId: true, salon: { select: { name: true } } },
+  });
+  if (!before) throw httpError("نظر یافت نشد", 404);
+  return applyReply(before, input.reply, user.id, user.phone);
+}
+
+/** همان کار برای سالن‌دار: فقط به نظرات سالن خودش */
+export async function setReviewReplyForSalon(salonId: string, input: ReviewReplyInput) {
+  const user = await requireSalonManage(salonId);
+  const before = await prisma.review.findUnique({
+    where: { id: input.reviewId },
+    select: { id: true, reply: true, salonId: true, salon: { select: { name: true } } },
+  });
+  if (!before || before.salonId !== salonId) throw httpError("نظر یافت نشد", 404);
+  return applyReply(before, input.reply, user.id, user.phone);
+}
+
+async function applyReply(
+  before: { id: string; reply: string | null; salonId: string; salon: { name: string } | null },
+  reply: string | undefined,
+  actorId: string,
+  actorPhone: string,
+) {
+  const trimmed = reply?.trim();
+  const nextReply = trimmed && trimmed.length > 0 ? trimmed : null;
+  const review = await prisma.review.update({
+    where: { id: before.id },
+    data: { reply: nextReply, repliedAt: nextReply ? new Date() : null },
+    select: { id: true, reply: true, repliedAt: true },
+  });
+  await logAudit({
+    actorId,
+    actorPhone,
+    action: nextReply ? "reply_review" : "delete_review_reply",
+    entityType: "Review",
+    entityId: before.id,
+    before: { reply: before.reply, salonId: before.salonId, salonName: before.salon?.name ?? null },
+    after: { reply: review.reply, repliedAt: review.repliedAt },
+  });
+  return review;
+}
+
+/** نظرات یک سالن به‌همراه پاسخ‌ها، برای پنل سالن‌دار */
+export async function listSalonReviewsForOwner(salonId: string) {
+  await requireSalonManage(salonId);
+  const reviews = await prisma.review.findMany({
+    where: { salonId },
+    include: {
+      customer: { select: { name: true, phone: true } },
+      staff: { select: { name: true } },
+    },
+    orderBy: { createdAt: "desc" },
+    take: 100,
+  });
+  return reviews.map((r) => ({
+    id: r.id,
+    rating: r.rating,
+    comment: r.comment,
+    customerName: r.customer.name ?? r.customer.phone,
+    staff: r.staff?.name ?? null,
+    reply: r.reply,
+    repliedAt: r.repliedAt,
+    createdAt: r.createdAt,
+  }));
+}
diff --git a/src/lib/salon-url.ts b/src/lib/salon-url.ts
new file mode 100644
index 0000000..f25ec48
--- /dev/null
+++ b/src/lib/salon-url.ts
@@ -0,0 +1,106 @@
+/**
+ * یاریاب آدرس عمومی سالن — همهٔ نمایش‌ها و لینک‌های صفحهٔ سالن باید از این‌جا عبور کنند.
+ *
+ * اولویت آدرس:
+ * ۱) دامنهٔ اختصاصی تأییدشدهٔ سالن
+ * ۲) ساب‌دامین روی دامنهٔ اصلی (bahar.localhost:4173 یا bahar.example.com) — وقتی فعال باشد
+ * ۳) مسیر /s/<slug> روی همان اوریج (پیش‌فرض امن)
+ *
+ * تطبیق ساب‌دامین در `src/proxy.ts` انجام می‌شود؛ این فایل فقط آدرس را «می‌سازد».
+ * بدون import از ماژول‌های دیگر نوشته شده تا در تست‌های Node بدون resolver هم اجرا شود.
+ */
+
+/** آدرس پایهٔ نصب (مشابه `SITE_URL` در `src/lib/site.ts`) */
+function siteUrl(): string {
+  const raw =
+    process.env.NEXT_PUBLIC_SITE_URL?.trim() ||
+    process.env.NEXT_PUBLIC_APP_URL?.trim() ||
+    "http://localhost:3000";
+  return raw.replace(/\/+$/, "");
+}
+
+function rootDomain(): string {
+  return (process.env.NEXT_PUBLIC_ROOT_DOMAIN ?? "localhost").trim().toLowerCase();
+}
+
+/** برچسب DNS معتبر: فقط حرف کوچک/عدد/خط تیره، بدون خط تیره در ابتدا/انتها، حداکثر ۶۳ نویسه */
+function isDnsLabel(slug: string): boolean {
+  return /^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$/.test(slug);
+}
+
+type OriginParts = { proto: string; hostname: string; port: string };
+
+/** تجزیهٔ اوریج یا هاست درخواست («http://localhost:4173» یا «localhost:4173») */
+export function parseOrigin(origin: string): OriginParts | null {
+  try {
+    const url = /^https?:\/\//i.test(origin) ? new URL(origin) : new URL(`http://${origin}`);
+    return { proto: url.protocol, hostname: url.hostname.toLowerCase(), port: url.port };
+  } catch {
+    return null;
+  }
+}
+
+function isLocalHost(hostname: string): boolean {
+  return hostname === "localhost" || hostname === "127.0.0.1" || hostname === "[::1]";
+}
+
+/** لوکال یا خودش ساب‌دامین لوکال («bahar.localhost») */
+function isLocalish(hostname: string): boolean {
+  return isLocalHost(hostname) || hostname.endsWith(".localhost");
+}
+
+/**
+ * آیا حالت ساب‌دامین برای این اوریج فعال است؟
+ * - روی localhost/127.0.0.1 همیشه فعال (مرورگرها `*.localhost` را خودکار به همین
+ *   آدرس حل می‌کنند؛ در ویندوز ۱۱ و کاوشگرهای مدرن نیاز به فایل hosts نیست)
+ * - در نصب واقعی: وقتی هاست، خودِ دامنهٔ اصلی یا ساب‌دامین آن است و ROOT_DOMAIN تنظیم شده
+ * اوریج‌های دیگر (دامنهٔ اختصاصی سالن) دست‌نخورده می‌مانند.
+ */
+export function subdomainMode(origin: string): boolean {
+  const parts = parseOrigin(origin);
+  if (!parts) return false;
+  const { hostname } = parts;
+  if (isLocalish(hostname)) return true;
+  const root = rootDomain();
+  if (root === "localhost") return false;
+  return hostname === root || hostname.endsWith(`.${root}`);
+}
+
+/**
+ * آدرس مطلق صفحهٔ عمومی سالن از روی اوریج جاری.
+ * اگر ساب‌دامین ممکن نباشد (اسلاگ غیرمجاز برای DNS یا میزبان نامرتبط)، مسیر /s/<slug> برمی‌گردد.
+ */
+export function salonUrlFromOrigin(slug: string, origin: string): string {
+  const base = origin.replace(/\/+$/, "");
+  const fallback = `${base}/s/${slug}`;
+  const parts = parseOrigin(origin);
+  if (!isDnsLabel(slug) || !parts || !subdomainMode(origin)) return fallback;
+  const { proto, hostname, port } = parts;
+  const portSuffix = port ? `:${port}` : "";
+  // روی localhost (یا خودش *.localhost) همیشه «<slug>.localhost» (پروتکل اوریج می‌ماند)
+  if (isLocalish(hostname)) return `${proto}//${slug}.localhost${portSuffix}`;
+  return `${proto}//${slug}.${rootDomain()}${portSuffix}`;
+}
+
+/**
+ * آدرس عمومی سالن در اجزای سمت سرور (داشبورد، متادیتا و …).
+ * @param host هاست درخواست جاری (هدر `host`) — اگر نبود، از آدرس پایهٔ نصب استفاده می‌شود
+ */
+export function salonPublicUrl(
+  salon: { slug: string; customDomain?: string | null; domainStatus?: string | null },
+  host?: string | null
+): string {
+  if (salon.customDomain && salon.domainStatus === "VERIFIED") {
+    return `https://${salon.customDomain}`;
+  }
+  if (!host) return salonUrlFromOrigin(salon.slug, siteUrl());
+  // هاست‌های غیرمحلی پشت پروکس HTTPS سرو می‌شوند (هدر host خودِ پورت را نگه می‌دارد)
+  const bare = host.toLowerCase().replace(/:[0-9]+$/, "");
+  const proto = isLocalHost(bare) || bare.endsWith(".localhost") ? guessLocalProto() : "https";
+  return salonUrlFromOrigin(salon.slug, `${proto}://${host}`);
+}
+
+/** در توسعه https فعال است فقط وقتی آدرس پایهٔ نصب https باشد (مثلاً bots…tr:8443) */
+function guessLocalProto(): string {
+  return siteUrl().startsWith("https://") ? "https" : "http";
+}
