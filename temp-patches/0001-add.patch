+import { getSetting } from "@/lib/settings";
+
+/** اطلاعات تماس سایت از تنظیمات (کلیدهای contact.*) */
+export type ContactInfo = { phone: string; email: string; address: string };
+
+export async function getContactInfo(): Promise<ContactInfo> {
+  const [phone, email, address] = await Promise.all([
+    getSetting("contact.phone"),
+    getSetting("contact.email"),
+    getSetting("contact.address"),
+  ]);
+  return {
+    phone: phone?.trim() || "021-00000000",
+    email: email?.trim() || "info@nobino.local",
+    address: address?.trim() || "تهران",
+  };
+}
