@@ -0,0 +1,36 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { filterAgenda, type AgendaFilterRow } from "../src/lib/ui/agenda-filter.ts";
+
+type Row = AgendaFilterRow & { id: string };
+
+const rows: Row[] = [
+  { id: "1", employeeId: "st-a", service: "کوتاهی", status: "CONFIRMED" },
+  { id: "2", employeeId: "st-b", service: "رنگ مو", status: "COMPLETED" },
+  { id: "3", employeeId: null, service: "کوتاهی", status: "REQUESTED" }, // بدون ترجیح آرایشگر
+];
+
+const ids = (r: Row[]) => r.map((x) => x.id).join(",");
+
+test("همه آرایشگران (رشتهٔ خالی = پیش‌فرض): هیچ نوبتی حذف نمی‌شود", () => {
+  assert.equal(ids(filterAgenda(rows, { staffId: "", service: "", status: "" })), "1,2,3");
+});
+
+test("فیلتر آرایشگر بر پایهٔ شناسه: فقط نوبت‌های همان نفر — حتی اگر نامش عوض شود", () => {
+  assert.equal(ids(filterAgenda(rows, { staffId: "st-a" })), "1");
+  assert.equal(ids(filterAgenda(rows, { staffId: "st-b" })), "2");
+});
+
+test("نوبت بدون آرایشگر هنگام انتخاب یک نفر خاص حذف می‌شود", () => {
+  assert.equal(filterAgenda(rows, { staffId: "st-a" }).some((r) => r.employeeId === null), false);
+});
+
+test("فیلتر خدمت و وضعیت ترکیبی کار می‌کند", () => {
+  assert.equal(ids(filterAgenda(rows, { service: "کوتاهی" })), "1,3");
+  assert.equal(ids(filterAgenda(rows, { service: "کوتاهی", status: "REQUESTED" })), "3");
+  assert.equal(ids(filterAgenda(rows, { staffId: "st-a", status: "COMPLETED" })), "");
+});
+
+test("رشتهٔ تعریف‌نشده (undefined) مثل «همه» رفتار می‌کند", () => {
+  assert.equal(ids(filterAgenda(rows, {})), "1,2,3");
+});
