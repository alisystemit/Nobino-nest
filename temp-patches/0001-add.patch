+import test from "node:test";
+import assert from "node:assert/strict";
+import { parseOrigin, subdomainMode, salonUrlFromOrigin, salonPublicUrl } from "../src/lib/salon-url.ts";
+
+// ROOT_DOMAIN پیش‌فرض در تست «localhost» است (بدون env) — حالت توسعهٔ محلی
+
+test("تجزیهٔ اوریج/هاست با پورت", () => {
+  assert.deepEqual(parseOrigin("http://localhost:4173"), { proto: "http:", hostname: "localhost", port: "4173" });
+  assert.deepEqual(parseOrigin("localhost:4173"), { proto: "http:", hostname: "localhost", port: "4173" });
+  assert.equal(parseOrigin("not a url"), null);
+});
+
+test("حالت ساب‌دامین روی localhost همیشه فعال است", () => {
+  assert.equal(subdomainMode("http://localhost:4173"), true);
+  assert.equal(subdomainMode("http://127.0.0.1:3000"), true);
+  // بدون ROOT_DOMAIN تنظیم‌شده، دامنهٔ واقعی ساب‌دامین نمی‌شود
+  assert.equal(subdomainMode("https://bots.example.com"), false);
+});
+
+test("آدرس سالن روی لوکال به شکل <slug>.localhost:<port> ساخته می‌شود", () => {
+  assert.equal(salonUrlFromOrigin("bahar", "http://localhost:4173"), "http://bahar.localhost:4173");
+  assert.equal(salonUrlFromOrigin("mah", "http://localhost:3000"), "http://mah.localhost:3000");
+});
+
+test("اسلاگ غیرمجاز DNS به مسیر /s/<slug> برمی‌گردد", () => {
+  // خط تیره در ابتدا/انتها برای برچسب DNS نامعتبر است
+  assert.equal(salonUrlFromOrigin("-bad", "http://localhost:4173"), "http://localhost:4173/s/-bad");
+  assert.equal(salonUrlFromOrigin("bad-", "http://localhost:4173"), "http://localhost:4173/s/bad-");
+});
+
+test("اوریج خودش ساب‌دامین لوکال باشد، آدرس ریشهٔ همان ساب‌دامین می‌ماند", () => {
+  assert.equal(salonUrlFromOrigin("bahar", "http://bahar.localhost:4178"), "http://bahar.localhost:4178");
+  // سالن دیگر از روی ساب‌دامین یک سالن دیگر هم به شکل ساب‌دامین ساخته می‌شود
+  assert.equal(salonUrlFromOrigin("gisso", "http://bahar.localhost:4178"), "http://gisso.localhost:4178");
+});
+
+test("سالن روی دامنهٔ اختصاصیِ تأییدشده، ساب‌دامین نمی‌گیرد", () => {
+  const url = salonPublicUrl({ slug: "bahar", customDomain: "bahar.ir", domainStatus: "VERIFIED" }, "localhost:4173");
+  assert.equal(url, "https://bahar.ir");
+});
+
+test("دامنهٔ اختصاصیِ تأییدنشده نادیده گرفته می‌شود", () => {
+  const url = salonPublicUrl({ slug: "bahar", customDomain: "bahar.ir", domainStatus: "PENDING" }, "localhost:4173");
+  assert.equal(url, "http://bahar.localhost:4173");
+});
+
+test("هاست درخواست بدون پورت لوکال → همان پروتکل و ساب‌دامین", () => {
+  assert.equal(salonPublicUrl({ slug: "nahal" }, "localhost"), "http://nahal.localhost");
+});
