+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  describeAction,
+  describeEntity,
+  describeField,
+  formatAuditValue,
+  diffAudit,
+  hasAuditDetails,
+} from "../src/lib/audit-labels.ts";
+
+test("اقدامات شناخته‌شده فارسی می‌شوند و ناشناخته خودِ کد می‌ماند (هیچ چیزی پنهان نمی‌شود)", () => {
+  assert.equal(describeAction("change_salon_status"), "تغییر وضعیت سالن (تأیید/فعال‌سازی)");
+  assert.equal(describeAction("broadcast"), "ارسال پیامک سراسری");
+  assert.equal(describeAction("some_future_action"), "some_future_action");
+});
+
+test("موجودیت و فیلد: ترجمه و fallback", () => {
+  assert.equal(describeEntity("SupportTicket"), "تیکت پشتیبانی");
+  assert.equal(describeEntity("Mystery"), "Mystery");
+  assert.equal(describeField("isApproved"), "تأیید شده");
+  assert.equal(describeField("weirdKey"), "weirdKey");
+});
+
+test("قالب‌بندی مقدار: بولین، خالی، enum، عدد لاتین، رشتهٔ بلند", () => {
+  assert.equal(formatAuditValue(true), "بله");
+  assert.equal(formatAuditValue(false), "خیر");
+  assert.equal(formatAuditValue(null), "—");
+  assert.equal(formatAuditValue(""), "—");
+  assert.equal(formatAuditValue("SALON_OWNER"), "مالک سالن (SALON_OWNER)");
+  assert.equal(formatAuditValue(120000), "120000");
+  const long = "الف".repeat(200);
+  assert.ok(formatAuditValue(long).endsWith("…") && formatAuditValue(long).length <= 122);
+});
+
+test("diffAudit فقط تغییرات واقعی را می‌آورد با قبل و بعد فارسی", () => {
+  const rows = diffAudit({ role: "CUSTOMER", isActive: true }, { role: "AGENT", isActive: true });
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].key, "role");
+  assert.equal(rows[0].from, "مشتری (CUSTOMER)");
+  assert.equal(rows[0].to, "نماینده (AGENT)");
+});
+
+test("diffAudit ساختار ایجاد/حذف: مقدار نبودن با — نمایش داده می‌شود", () => {
+  const created = diffAudit(null, { code: "VIP20", percent: 20 });
+  assert.equal(created.length, 2);
+  assert.equal(created[0].from, "—");
+  const deleted = diffAudit({ code: "VIP20" }, null);
+  assert.equal(deleted[0].to, "—");
+});
+
+test("diffAudit کلیدهای شناسایی را حذف می‌کند و آبجکت‌های تودرتو را JSON فشرده می‌کند", () => {
+  const rows = diffAudit(
+    { id: "x", createdAt: "2026-01-01", saved: [{ plan: "PRO", key: "maxBranches", value: 2 }] },
+    { saved: [{ plan: "PRO", key: "maxBranches", value: 5 }] }
+  );
+  assert.equal(rows.length, 1);
+  assert.match(rows[0].to, /maxBranches/);
+});
+
+test("hasAuditDetails: نبودِ قبل و بعد یعنی بدون جزئیات", () => {
+  assert.equal(hasAuditDetails(null, null), false);
+  assert.equal(hasAuditDetails(undefined, undefined), false);
+  assert.equal(hasAuditDetails(null, { a: 1 }), true);
+  assert.equal(hasAuditDetails({ a: 1 }, null), true);
+});
