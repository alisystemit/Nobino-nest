+++ b/src/components/SalonLink.tsx
@@ -0,0 +1,54 @@
+"use client";
+
+import { useSyncExternalStore } from "react";
+import Link from "next/link";
+import { salonUrlFromOrigin, subdomainMode } from "@/lib/salon-url";
+
+/**
+ * لینک صفحهٔ عمومی سالن — روی دامنه‌های ساب‌دامینی (از جمله *.localhost در توسعه)
+ * آدرس مطلق ساب‌دامین می‌سازد؛ در غیر این صورت همان مسیر /s/<slug> می‌ماند.
+ *
+ * اوریج با useSyncExternalStore خوانده می‌شود: در SSR و هیدریشن مقدار خالی است
+ * (پس href اولیه روی سرور و کلاینت یکی می‌ماند) و بی‌درنگ پس از hydration به
+ * آدرس ساب‌دامین ارتقا می‌یابد — بدون mismatch و بدون setState در effect.
+ */
+const noopSubscribe = () => () => {};
+const getClientOrigin = () => window.location.origin;
+const getServerOrigin = () => "";
+
+export default function SalonLink({
+  slug,
+  customDomain,
+  domainStatus,
+  className,
+  children,
+}: {
+  slug: string;
+  customDomain?: string | null;
+  domainStatus?: string;
+  className?: string;
+  children: React.ReactNode;
+}) {
+  const origin = useSyncExternalStore(noopSubscribe, getClientOrigin, getServerOrigin);
+
+  let href = `/s/${slug}`;
+  if (customDomain && domainStatus === "VERIFIED") {
+    href = `https://${customDomain}`;
+  } else if (origin && subdomainMode(origin)) {
+    href = salonUrlFromOrigin(slug, origin);
+  }
+
+  // لینک داخلی (هم‌ریش) با next/link بهتر preload می‌شود؛ لینک ساب‌دامین باید <a> باشد
+  if (href.startsWith("/")) {
+    return (
+      <Link href={href} className={className}>
+        {children}
+      </Link>
+    );
+  }
+  return (
+    <a href={href} className={className}>
+      {children}
+    </a>
+  );
+}
