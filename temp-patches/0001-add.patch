@@ -0,0 +1,19 @@
+require("dotenv").config();
+const { Client } = require("pg");
+(async () => {
+  const c = new Client({ connectionString: process.env.DATABASE_URL });
+  await c.connect();
+  const t = await c.query(
+    `select column_name, data_type from information_schema.columns
+      where table_schema='public' and table_name='Notification' and column_name in ('nextAttemptAt','sentAt','createdAt','updatedAt')`,
+  );
+  console.table(t.rows);
+  const n = await c.query(
+    `select count(*)::int as stuck, max("nextAttemptAt") as mx, now() as dbnow
+       from "Notification" where status='PENDING' and "nextAttemptAt" < now()`,
+  );
+  console.table(n.rows);
+  const tz = await c.query("show timezone");
+  console.log("session tz:", tz.rows[0].TimeZone, "| local:", new Date().toString());
+  await c.end();
+})().catch((e) => console.log("ERR", e.message));
