+/**
+ * فیلتر نوبت‌ها برای نمای تقویم سالن (SalonManager → CalendarView).
+ * خالص و بدون DOM است تا با `node --test` قابل تست باشد.
+ *
+ * نکتهٔ مهم: تطبیق آرایشگر با **شناسه** انجام می‌شود نه نام —
+ * اگر نام پرسنل ویرایش شود، فیلتر بر پایهٔ نام نوبت‌های درست را از دست می‌دهد
+ * و کاربر «همه آرایشگران» را انتخاب می‌کند ولی نتیجه خالی/گیج‌کننده می‌بیند.
+ */
+
+export type AgendaFilterRow = {
+  employeeId?: string | null;
+  service?: string | null;
+  status?: string | null;
+};
+
+export type AgendaFilters = {
+  /** رشتهٔ خالی = «همه آرایشگران» (پیش‌فرض): هیچ نوبتی به‌خاطر آرایشگر حذف نمی‌شود */
+  staffId?: string;
+  /** رشتهٔ خالی = «همه خدمات» */
+  service?: string;
+  /** رشتهٔ خالی = «همه وضعیت‌ها» */
+  status?: string;
+};
+
+export function filterAgenda<T extends AgendaFilterRow>(rows: T[], f: AgendaFilters): T[] {
+  return rows.filter((r) => {
+    if (f.staffId && r.employeeId !== f.staffId) return false;
+    if (f.service && r.service !== f.service) return false;
+    if (f.status && r.status !== f.status) return false;
+    return true;
+  });
+}
