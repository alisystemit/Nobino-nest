+import test from "node:test";
+import assert from "node:assert/strict";
+import { neshanMapUrl, baladMapUrl, mapSearchQuery } from "../src/lib/map-links.ts";
+
+const TEHRAN = { latitude: 35.6989, longitude: 51.3989 };
+
+test("نشان با مختصات: لینک share با ترتیب lat,lng و اعشار ثابت", () => {
+  assert.equal(neshanMapUrl(TEHRAN, "نام سالن تهران آدرس"), "https://neshan.org/maps/share/35.698900,51.398900");
+});
+
+test("نشان بدون مختصات: لینک جست‌وجو با encodeURIComponent", () => {
+  const q = "آرایشگاه مهرازا تهران، سعادت‌آباد";
+  assert.equal(neshanMapUrl(null, q), `https://neshan.org/maps/search/${encodeURIComponent(q)}`);
+});
+
+test("بلد با مختصات: هش zoom/lat/lng", () => {
+  assert.equal(baladMapUrl(TEHRAN, "بی‌اهمیت"), "https://balad.ir/#16/35.698900/51.398900");
+});
+
+test("بلد بدون مختصات: جست‌وجو با پارامتر text", () => {
+  const q = "سالن بی بی لوکس کیش";
+  assert.equal(baladMapUrl(undefined, q), `https://balad.ir/search?text=${encodeURIComponent(q)}`);
+});
+
+test("مختصات نامعتبر (NaN/خارج از بازه) مثل بدون مختصات رفتار می‌کند", () => {
+  const q = "تست";
+  assert.equal(neshanMapUrl({ latitude: NaN, longitude: 51.4 }, q), `https://neshan.org/maps/search/${encodeURIComponent(q)}`);
+  assert.equal(baladMapUrl({ latitude: 120, longitude: 51.4 }, q), `https://balad.ir/search?text=${encodeURIComponent(q)}`);
+});
+
+test("mapSearchQuery بخش‌های خالی را حذف و فاصلهٔ اضافی را جمع می‌کند", () => {
+  assert.equal(mapSearchQuery("  مهرازا ", null, " سعادت‌آباد "), "مهرازا سعادت‌آباد");
+  assert.equal(mapSearchQuery("مهرازا", "", undefined), "مهرازا");
+});
+
+test("mapSearchQuery شهر تکراری داخل آدرس را دوباره نمی‌آورد", () => {
+  assert.equal(mapSearchQuery("سالن ماه", "تهران", "تهران، سعادت‌آباد"), "سالن ماه تهران، سعادت‌آباد");
+  assert.equal(mapSearchQuery("سالن ماه", "تهران", "تهران"), "سالن ماه تهران");
+  // وقتی آدرس با شهر شروع نمی‌شود، شهر می‌ماند
+  assert.equal(mapSearchQuery("سالن ماه", "کرج", "سعادت‌آباد"), "سالن ماه کرج سعادت‌آباد");
+});
