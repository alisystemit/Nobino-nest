@@ -0,0 +1,91 @@
+"use client";
+
+import { useState } from "react";
+import { smsProviderMeta } from "@/lib/sms/providers";
+
+const input =
+  "w-full rounded-xl border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 outline-none transition focus:border-pink-500 focus:ring-2 focus:ring-pink-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100";
+const primaryBtn =
+  "rounded-xl bg-gradient-to-l from-pink-600 to-purple-600 px-5 py-2.5 text-sm font-black text-white shadow-md shadow-pink-500/20 transition hover:opacity-95 disabled:opacity-50";
+
+type Msg = { ok: boolean; text: string } | null;
+
+/** کارت ارسال پیامک تست؛ اگر provider انتخاب نشود سرویس فعال استفاده می‌شود */
+export default function SmsTestCard({ onMsg }: { onMsg: (m: Msg) => void }) {
+  const [provider, setProvider] = useState("");
+  const [phone, setPhone] = useState("");
+  const [sending, setSending] = useState(false);
+  const [result, setResult] = useState<Msg>(null);
+
+  async function send() {
+    if (phone.replace(/\D/g, "").length < 11) {
+      setResult({ ok: false, text: "شماره موبایل معتبر وارد کنید (۱۱ رقم)." });
+      return;
+    }
+    setSending(true);
+    setResult(null);
+    try {
+      const r = await fetch("/api/admin/sms/test", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ phone: phone.replace(/\D/g, ""), ...(provider ? { provider } : {}) }),
+      });
+      const d = await r.json();
+      const m: Msg = d.success ? { ok: true, text: d.message ?? "پیامک آزمایشی ارسال شد ✅" } : { ok: false, text: d.error ?? "ارسال پیامک تست ناموفق بود" };
+      setResult(m);
+      onMsg(m);
+    } catch {
+      const m: Msg = { ok: false, text: "خطای شبکه در ارسال پیامک تست" };
+      setResult(m);
+      onMsg(m);
+    } finally {
+      setSending(false);
+    }
+  }
+
+  return (
+    <div className="rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
+      <div className="flex items-center justify-between">
+        <h4 className="text-sm font-extrabold text-neutral-800 dark:text-neutral-100">📤 ارسال پیامک تست</h4>
+        <span className="text-[11px] text-neutral-400 dark:text-neutral-500">بدون ثبت در دیتابیس — فقط ارسال واقعی</span>
+      </div>
+      <p className="mt-1 text-xs text-neutral-500 dark:text-neutral-400">برای اطمینان از کارکرد کلیدهای سرویس پیامک؛ نتیجه در «گزارش پیامک» قابل پیگیری است.</p>
+      <div className="mt-3 grid gap-2 sm:grid-cols-[1fr_220px_auto]">
+        <input
+          className={input}
+          placeholder="09xxxxxxxxx"
+          dir="ltr"
+          inputMode="numeric"
+          aria-label="شماره موبایل برای تست"
+          value={phone}
+          onChange={(e) => setPhone(e.target.value.replace(/\D/g, "").slice(0, 11))}
+          onKeyDown={(e) => {
+            if (e.key === "Enter") send();
+          }}
+        />
+        <select className={input} value={provider} onChange={(e) => setProvider(e.target.value)} aria-label="سرویس پیامک">
+          <option value="">سرویس فعال (پیش‌فرض)</option>
+          {smsProviderMeta.map((p) => (
+            <option key={p.id} value={p.id}>
+              {p.name}
+            </option>
+          ))}
+        </select>
+        <button onClick={send} disabled={sending} className={`${primaryBtn} whitespace-nowrap`}>
+          {sending ? "در حال ارسال..." : "ارسال تست"}
+        </button>
+      </div>
+      {result && (
+        <div
+          className={`mt-3 rounded-xl px-3 py-2 text-xs font-bold ring-1 ring-inset ${
+            result.ok
+              ? "bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-950/40 dark:text-emerald-300 dark:ring-emerald-400/20"
+              : "bg-red-50 text-red-700 ring-red-600/20 dark:bg-red-950/40 dark:text-red-300 dark:ring-red-400/20"
+          }`}
+        >
+          {result.text}
+        </div>
+      )}
+    </div>
+  );
+}
