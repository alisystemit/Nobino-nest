+++ b/src/components/SalonQrCard.tsx
@@ -0,0 +1,38 @@
+import QRCode from "qrcode";
+
+type Props = {
+  /** نشانی عمومی سالن (ساب‌دامین/دامنهٔ اختصاصی) که در QR رمزنگاری می‌شود */
+  url: string;
+  name: string;
+};
+
+/**
+ * کارت QR صفحهٔ سالن: مشتری با اسکن، مستقیم وارد آدرس ساب‌دامین سالن می‌شود.
+ * SVG سمت سرور تولید می‌شود (بدون وابستگی کلاینت)؛ خروجی qrcode فقط مسیرهای SVG است.
+ */
+export default async function SalonQrCard({ url, name }: Props) {
+  const svg = await QRCode.toString(url, {
+    type: "svg",
+    errorCorrectionLevel: "M",
+    margin: 1,
+    width: 160,
+    color: { dark: "#171717", light: "#ffffff" },
+  });
+
+  return (
+    <div className="rounded-3xl border border-neutral-200 bg-white p-5 text-center shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
+      <h3 className="text-sm font-extrabold text-neutral-900 dark:text-neutral-100">QR آدرس سالن</h3>
+      <p className="mt-1 text-[11px] text-neutral-500 dark:text-neutral-400">با اسکن، وارد صفحهٔ نوبت‌دهی شوید</p>
+      <div
+        className="mx-auto mt-3 w-fit rounded-2xl bg-white p-3 shadow-sm ring-1 ring-neutral-200 dark:ring-neutral-700 [&_svg]:block"
+        role="img"
+        aria-label={`QR کد ${name}`}
+        dangerouslySetInnerHTML={{ __html: svg }}
+      />
+      <div className="mt-3 text-sm font-bold text-neutral-800 dark:text-neutral-200">{name}</div>
+      <div className="mt-1 truncate text-[11px] text-neutral-500 dark:text-neutral-400" dir="ltr" title={url}>
+        {url.replace(/^https?:\/\//, "")}
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/SmsReportPanel.tsx b/src/components/SmsReportPanel.tsx
new file mode 100644
index 0000000..7f2f293
--- /dev/null
+++ b/src/components/SmsReportPanel.tsx
@@ -0,0 +1,686 @@
+"use client";
+
+import { Fragment, useCallback, useEffect, useState } from "react";
+import {
+  faDate,
+  faDateFull,
+  faNum,
+  faTimeAgo,
+  faTimeUntil,
+  localizeNotifError,
+  MAX_SMS_ATTEMPTS,
+  notifBodyText,
+  notifStatusMeta,
+  notifTypeLabel,
+  NOTIF_CHANNEL_META,
+  NOTIF_STATUS_META,
+} from "@/lib/notifications/fa";
+
+/* ─── انواع محلی ─────────────────────────────────────────────────────── */
+
+type NotifItem = {
+  id: string;
+  type: string;
+  channel: string;
+  status: string;
+  attempts: number;
+  recipient: string;
+  lastError?: string | null;
+  sentAt?: string | null;
+  nextAttemptAt?: string | null;
+  createdAt: string;
+  updatedAt?: string | null;
+  uniqueKey?: string | null;
+  payload?: unknown;
+  salonName?: string | null;
+};
+
+type NotifSummary = {
+  PENDING?: number;
+  SENT?: number;
+  FAILED?: number;
+  DROPPED?: number;
+  channels?: Record<string, number>;
+  unitCost?: number;
+  estimatedCost?: number;
+  sentToday?: number;
+  pendingStuck?: number;
+  totalAll?: number;
+};
+
+type NotifScope = {
+  total?: number;
+  byStatus?: Record<string, number>;
+  successRate?: number;
+  days?: number;
+  from?: string | null;
+  shown?: number;
+};
+
+type NotifData = {
+  summary: NotifSummary;
+  scope: NotifScope;
+  types: { type: string; count: number }[];
+  notifications: NotifItem[];
+};
+
+type Msg = { ok: boolean; text: string } | null;
+
+const input =
+  "w-full rounded-xl border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 outline-none transition focus:border-pink-500 focus:ring-2 focus:ring-pink-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100";
+
+const WINDOWS = [
+  { days: 0, label: "همهٔ زمان‌ها" },
+  { days: 1, label: "۲۴ ساعت اخیر" },
+  { days: 7, label: "۷ روز اخیر" },
+  { days: 30, label: "۳۰ روز اخیر" },
+  { days: 90, label: "۹۰ روز اخیر" },
+];
+
+/* ─── گاه‌شمار هر پیامک ──────────────────────────────────────────────── */
+
+/** یک سطر زمانی: برچسب فارسی + تاریخ شمسی + فاصلهٔ نسبی + منبع خام */
+type TimeLine = { icon: string; label: string; iso: string; date: string; rel: string; tone: string };
+
+const toneSent = "text-emerald-600 dark:text-emerald-400";
+const toneWait = "text-amber-600 dark:text-amber-400";
+const toneFail = "text-red-600 dark:text-red-400";
+const toneMuted = "text-neutral-500 dark:text-neutral-400";
+
+/** متن «در صف مانده» یا «رسیده» را از روی فاصلهٔ نسبی تشخیص می‌دهد */
+function isDue(nextAttemptAt?: string | null): boolean {
+  if (!nextAttemptAt) return true;
+  return faTimeUntil(nextAttemptAt) === "هم‌اکنون";
+}
+
+function line(icon: string, label: string, iso: string | null | undefined, tone = toneMuted, future = false): TimeLine | null {
+  if (!iso) return null;
+  const t = new Date(iso).getTime();
+  if (Number.isNaN(t)) return null;
+  return { icon, label, iso, date: faDate(iso), rel: future ? faTimeUntil(iso) : faTimeAgo(iso), tone };
+}
+
+/**
+ * روایت زمانی یک اعلان: چه زمانی در صف ثبت شد، چه زمانی ارسال شد، یا اگر هنوز
+ * ارسال نشده، تلاش بعدی کی است و آخرین تلاش کِی بوده است.
+ */
+function timelineOf(n: NotifItem): TimeLine[] {
+  const out: (TimeLine | null)[] = [];
+
+  if (n.status === "SENT") {
+    out.push(line("✅", "ارسال شد", n.sentAt ?? n.updatedAt ?? n.createdAt, toneSent));
+    if (n.sentAt && n.createdAt && n.sentAt !== n.createdAt) out.push(line("📥", "ثبت در صف", n.createdAt));
+    if (n.attempts > 0) out.push(line("🔁", `${faNum(n.attempts)} تلاش تا موفقیت`, n.updatedAt ?? n.sentAt, toneWait));
+  } else if (n.status === "PENDING") {
+    const due = isDue(n.nextAttemptAt);
+    out.push(
+      n.attempts > 0
+        ? line("⏱", due ? "تلاش بعدی فرا رسیده" : `تلاش ${faNum(n.attempts + 1)} بعدی`, n.nextAttemptAt, toneWait, !due)
+        : line("⏱", due ? "زمان ارسال فرا رسیده — در انتظار پردازشگر" : "برنامهٔ ارسال", n.nextAttemptAt, toneWait, !due),
+    );
+    if (n.attempts > 0) out.push(line("⚠", "آخرین تلاش ناموفق", n.updatedAt ?? n.createdAt, toneFail));
