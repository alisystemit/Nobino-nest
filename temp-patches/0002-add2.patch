+        ? { ok: true, text: `${data.message} — زمان پاسخ: ${Math.round((data.latencyMs ?? 0) / 100) / 10} ثانیه — نمونه: «${data.sample}»` }
+        : { ok: false, text: data.error ?? "تست اتصال ناموفق بود" };
+      setResult(m);
+      onMsg?.(m);
+    } catch {
+      const m: Msg = { ok: false, text: "خطای شبکه در تست اتصال" };
+      setResult(m);
+      onMsg?.(m);
+    } finally {
+      setTesting(false);
+    }
+  }
+
+  if (loading) return <div className="rounded-3xl border border-neutral-200 bg-white p-6 text-sm text-neutral-400 dark:border-neutral-800 dark:bg-neutral-900">در حال بارگذاری تنظیمات هوش مصنوعی...</div>;
+
+  const sttReady = stt.filter((s) => s.configured && s.id !== "mock");
+
+  return (
+    <section className="rounded-3xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div>
+          <h2 className="text-lg font-extrabold text-neutral-900 dark:text-neutral-100">🤖 هوش مصنوعی</h2>
+          <p className="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
+            کلید را وارد کنید، ذخیره کنید و تست بگیرید. پس از آن: دستیار مشتریان، تحلیل کسب‌وکار، تولید محتوا، استخراج نوبت از صوت.
+          </p>
+        </div>
+        <label className="flex cursor-pointer items-center gap-2 rounded-xl border border-neutral-200 px-3 py-2 text-xs font-bold text-neutral-700 dark:border-neutral-700 dark:text-neutral-200">
+          <input type="checkbox" checked={enabled} onChange={(e) => setEnabled(e.target.checked)} className="h-4 w-4 accent-pink-600" />
+          فعال‌سازی قابلیت‌های AI
+        </label>
+      </div>
+
+      {/* سرویس فعال */}
+      <div className="mt-5 grid gap-3 sm:grid-cols-3">
+        <div>
+          <label className="text-xs font-medium text-neutral-500">سرویس‌دهندهٔ متن (LLM)</label>
+          <select className={`${inputCls} mt-1`} value={preferred} onChange={(e) => setPreferred(e.target.value)}>
+            <option value="">خودکار (اولین کلیدِ پر)</option>
+            {providers.map((p) => (
+              <option key={p.id} value={p.id}>{p.name}</option>
+            ))}
+          </select>
+        </div>
+        <div>
+          <label className="text-xs font-medium text-neutral-500">مدل (اختیاری — پیش‌فرض سرویس)</label>
+          <input
+            className={`${inputCls} mt-1`}
+            dir="ltr"
+            placeholder={providers.find((p) => p.id === preferred)?.modelHint ?? "مثلاً gpt-4o-mini"}
+            value={form["ai.model"] ?? ""}
+            onChange={(e) => setv("ai.model", e.target.value)}
+          />
+        </div>
+        <div>
+          <label className="text-xs font-medium text-neutral-500">آدرس سرویس سفارشی (OpenAI-compatible)</label>
+          <input
+            className={`${inputCls} mt-1`}
+            dir="ltr"
+            placeholder="https://api.openrouter.ai/v1 یا http://localhost:11434/v1"
+            value={form["ai.custom.base_url"] ?? ""}
+            onChange={(e) => setv("ai.custom.base_url", e.target.value)}
+          />
+        </div>
+      </div>
+
+      {active && (
+        <p className="mt-3 rounded-xl bg-emerald-50 px-3 py-2 text-xs font-bold text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">
+          سرویس در حال استفاده الان: {active.provider} — مدل {active.model}
+        </p>
+      )}
+
+      {/* کلیدها */}
+      <div className="mt-5 grid gap-3 sm:grid-cols-2">
+        {providers.map((p) => {
+          const key = keySettingFor(p.id);
+          const val = form[key] ?? "";
+          const unchanged = val === KEEP_SECRET;
+          return (
+            <div key={p.id} className={`rounded-2xl border p-4 ${preferred === p.id ? "border-pink-400 bg-pink-50/40 dark:bg-pink-900/10" : "border-neutral-200 dark:border-neutral-800"}`}>
+              <div className="flex items-center justify-between">
+                <div className="font-bold text-neutral-800 dark:text-neutral-100">{p.name}</div>
+                <span className={`rounded-full px-2.5 py-0.5 text-[11px] font-bold ${p.keySet ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300" : "bg-neutral-100 text-neutral-500 dark:bg-neutral-800"}`}>
+                  {p.keySet ? `کلید فعال ${p.keyMasked ?? ""}` : "کلید تنظیم نشده"}
+                </span>
+              </div>
+              <p className="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{p.description}</p>
