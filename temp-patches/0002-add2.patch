 import { prisma } from "@/lib/prisma";
 import { enqueueSms } from "@/lib/notifications/queue";
+import { logAudit } from "@/lib/audit";
+
+export type Actor = { id?: string; phone?: string };
 
 /** ساخت اشتراک پس از پرداخت موفق */
 export async function activateSubscription(params: { salonId: string; packageId: string; period: string; autoRenew?: boolean }) {
@@ -79,3 +82,122 @@ export async function cancelSubscription(subId: string, reason = "CANCELLED") {
   }
   return updated;
 }
+
+/* ─── اکشن‌های سوپرادمین روی اشتراک ──────────────────────────────────── */
+
+const DAY_MS = 86_400_000;
+
+export type SubAction = "EXTEND" | "ACTIVATE" | "SUSPEND" | "CANCEL" | "SET_AUTO_RENEW";
+
+const ACTION_TO_STATUS: Record<SubAction, string | null> = {
+  EXTEND: "ACTIVE",
+  ACTIVATE: "ACTIVE",
+  SUSPEND: "SUSPENDED",
+  CANCEL: "CANCELLED",
+  SET_AUTO_RENEW: null,
+};
+
+/**
+ * اعمال یک اکشن مدیریتی روی اشتراک (فقط از مسیر ادمین).
+ * - EXTEND: دوره را اضافه می‌کند؛ اگر اشتراک منقضی نشده باشد «روی» تاریخ پایان
+ *   فعلی می‌افزاید تا روزهای خریداری‌نشده سوخت نشود، وگرنه از امروز.
+ * - ACTIVATE: فعال‌سازی مجدد (تعلیق/لغو/منقضی) و همگام‌سازی پلن سالن.
+ * - SUSPEND/CANCEL: مثل cancelSubscription ولی با حسابرسی و تاریخ‌های دقیق.
+ * - SET_AUTO_RENEW: تغییر فلگ تمدید خودکار.
+ * همیشه با قفل ردیف اشتراک+سالن در یک تراکنش انجام می‌شود.
+ */
+export async function applySubscriptionAction(
+  subId: string,
+  action: SubAction,
+  actor: Actor,
+  opts: { days?: number; autoRenew?: boolean; note?: string } = {},
+): Promise<{ ok: true; subscription: Awaited<ReturnType<typeof prisma.subscription.findUnique>> } | { ok: false; error: string }> {
+  const sub = await prisma.subscription.findUnique({
+    where: { id: subId },
+    include: { package: true, salon: { select: { id: true, name: true, phone: true } } },
+  });
+  if (!sub) return { ok: false, error: "اشتراک یافت نشد" };
+
+  const now = new Date();
+  const status = ACTION_TO_STATUS[action];
+  let endsAt = sub.endsAt;
+  let autoRenew = sub.autoRenew;
+  let addedDays = 0;
+
+  if (action === "EXTEND") {
+    const raw = Number(opts.days ?? 30);
+    const days = Math.min(Math.max(Math.trunc(raw) || 0, 1), 3660);
+    if (days <= 0) return { ok: false, error: "تعداد روز نامعتبر است" };
+    addedDays = days;
+    const base = sub.endsAt.getTime() > now.getTime() ? sub.endsAt.getTime() : now.getTime();
+    endsAt = new Date(base + days * DAY_MS);
+  } else if (action === "ACTIVATE") {
+    if (sub.endsAt.getTime() <= now.getTime()) {
+      const days = sub.period === "YEARLY" ? 365 : sub.package.durationDays > 0 ? sub.package.durationDays : 30;
+      endsAt = new Date(now.getTime() + days * DAY_MS);
+    }
+  } else if (action === "SET_AUTO_RENEW") {
+    autoRenew = Boolean(opts.autoRenew);
+  }
+
+  const before = {
+    status: sub.status,
+    endsAt: sub.endsAt.toISOString(),
+    autoRenew: sub.autoRenew,
+  };
+
+  await prisma.$transaction(async (tx) => {
+    await tx.subscription.update({
+      where: { id: subId },
+      data: {
+        status: status ?? sub.status,
+        endsAt,
+        autoRenew,
+        cancelledAt: status === "CANCELLED" || status === "SUSPENDED" ? now : status === "ACTIVE" ? null : undefined,
+      },
+    });
+
+    // یک سالن ممکن است چند اشتراک هم‌زمان داشته باشد؛ پلن و تاریخ پایان سالن باید
+    // از «تازه‌ترین اشتراک فعال باقی‌مانده» بازمحاسبه شود، نه کورکورانه FREE —
+    // وگرنه لغو یک اشتراک آزمایشی، اشتراک واقعی سالن را از نظر دسترسی خاموش می‌کند.
+    // (همان قاعده‌ای که activateSubscription با آخرین پرداخت اعمال می‌کند.)
+    const latest = await tx.subscription.findFirst({
+      where: { salonId: sub.salonId, status: "ACTIVE", endsAt: { gt: now } },
+      orderBy: { createdAt: "desc" },
+      include: { package: { select: { plan: true } } },
+    });
+
+    await tx.salon.update({
+      where: { id: sub.salonId },
+      data: {
+        plan: latest?.package.plan ?? "FREE",
+        subscriptionEndsAt: latest?.endsAt ?? null,
+        autoRenew: latest ? autoRenew : false,
+      },
+    });
+  });
+
+  const updated = await prisma.subscription.findUnique({ where: { id: subId } });
+  await logAudit({
+    actorId: actor.id,
+    actorPhone: actor.phone,
+    action: `subscription_${action.toLowerCase()}`,
+    entityType: "Subscription",
+    entityId: subId,
+    before: { status: before.status, endsAt: before.endsAt, autoRenew: before.autoRenew },
+    after: { status: updated?.status, endsAt: updated?.endsAt.toISOString(), autoRenew: updated?.autoRenew, addedDays: addedDays || undefined, note: opts.note || undefined },
+  });
+
+  // اطلاع‌رسانی از طریق صف اعلان (نه ارسال مستقیم)
+  if (sub.salon?.phone && (action === "EXTEND" || action === "ACTIVATE")) {
+    await enqueueSms({
+      type: action === "EXTEND" ? "SUBSCRIPTION_RENEWED" : "SUBSCRIPTION_ACTIVATED",
+      recipient: sub.salon.phone,
+      message: `اشتراک «${sub.package.name}» برای «${sub.salon.name}» ${action === "EXTEND" ? `به مدت ${addedDays} روز` : ""} فعال/تمدید شد تا ${endsAt.toLocaleDateString("fa-IR")}.`,
+      uniqueKey: `subadmin:${action}:${subId}:${endsAt.getTime()}`,
+      salonId: sub.salonId,
+    });
+  }
+
+  return { ok: true, subscription: updated };
+}
diff --git a/src/lib/ui/subscriptions-view.ts b/src/lib/ui/subscriptions-view.ts
