+ * پس اگر درخواستِ `/seed/mah-logo.svg` روی ساب‌دامین به `/s/mah/seed/mah-logo.svg` بازنویسی شود،
+ * بازنویسی به روت داینامیک نمی‌خورد و مرورگر به‌جای تصویر، ۴۰۴ (HTML) می‌گیرد.
+ *
+ * علامت تشخیص: بخشِ آخر مسیر نقطه دارد (پسوند فایل). صفحه‌های این پروژه و اسلاگ سالن
+ * (برچسب DNS: فقط `[a-z0-9-]`) نقطه ندارند، پس این بررسی بازنویسی صفحه‌ها را مختل نمی‌کند.
+ */
+export function isStaticAssetPath(pathname: string): boolean {
+  if (!pathname) return false;
+  const lastSegment = pathname.slice(pathname.lastIndexOf("/") + 1);
+  if (lastSegment === "." || lastSegment === "..") return false;
