+                className={`${inputCls} mt-2`}
+                dir="ltr"
+                type={unchanged ? "password" : "text"}
+                placeholder={unchanged ? "•••••••• (بدون تغییر)" : "sk-..."}
+                value={unchanged ? "" : val}
+                onChange={(e) => setv(key, e.target.value)}
+              />
+              {p.id === "openai" && (
+                <label className="mt-2 flex cursor-pointer items-center gap-2 text-[11px] font-medium text-neutral-500 dark:text-neutral-400">
+                  <input type="checkbox" checked={mirrorOpenAI} onChange={(e) => setMirrorOpenAI(e.target.checked)} className="h-3.5 w-3.5 accent-pink-600" />
+                  استفاده از همین کلید برای Whisper (تبدیل گفتار به متن)
+                </label>
+              )}
+              {preferred !== p.id && (
+                <button onClick={() => setPreferred(p.id)} className="mt-2 text-xs font-semibold text-pink-600 hover:underline">
+                  انتخاب به‌عنوان سرویس فعال
+                </button>
+              )}
+            </div>
+          );
+        })}
+      </div>
+
+      {/* وضعیت صوت */}
+      <div className="mt-6">
+        <h3 className="text-sm font-bold text-neutral-700 dark:text-neutral-200">ربات‌های تبدیل گفتار به متن (رزرو صوتی)</h3>
+        <div className="mt-2 flex flex-wrap gap-2">
+          {stt.map((s) => (
+            <span
+              key={s.id}
+              className={`rounded-full px-3 py-1 text-[11px] font-bold ${
+                s.configured ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300" : "bg-neutral-100 text-neutral-500 dark:bg-neutral-800"
+              }`}
+            >
+              {s.label} {s.configured ? "✓" : "—"}
+            </span>
+          ))}
+        </div>
+        <p className="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
+          {sttReady.length
+            ? `با ${sttReady.length} ربات صوتی، نوبت‌های صوتی بهصورت زنجیره‌ای (با fallback) پردازش می‌شوند.`
+            : "برای رزرو صوتی، حداقل کلید Groq (رایگان) یا OpenAI را در کارت «هوش صوتی» یا همین‌جا وارد کنید؛ فعلاً حالت Mock محلی استفاده می‌شود."}
+        </p>
+      </div>
+
+      {result && (
+        <p className={`mt-5 rounded-xl px-4 py-3 text-sm ${result.ok ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300" : "bg-red-50 text-red-600 dark:bg-red-900/30 dark:text-red-300"}`}>
+          {result.text}
+        </p>
+      )}
+
+      <div className="mt-5 flex flex-wrap gap-3">
+        <button onClick={save} disabled={saving} className={primaryBtn}>
+          {saving ? "در حال ذخیره..." : "💾 ذخیره تنظیمات AI"}
+        </button>
+        <button onClick={test} disabled={testing} className={ghostBtn}>
+          {testing ? "در حال تست..." : "🔌 تست اتصال"}
+        </button>
+      </div>
+    </section>
+  );
+}
+
+/** نام کلید تنظیمی هر سرویس (مطوب src/lib/ai/llm.ts) */
+function keySettingFor(id: string): string {
+  if (id === "openai") return "openai.api_key";
+  if (id === "groq") return "stt.groq.key";
+  if (id === "deepseek") return "ai.deepseek.key";
+  return "ai.custom.key";
+}
