+                        placeholder={unchanged ? "•••••••• (بدون تغییر)" : f.placeholder}
+                        value={unchanged ? "" : val}
+                        onChange={(e) => setRows((r) => ({ ...r, [f.key]: e.target.value }))}
+                      />
+                    </div>
+                  );
+                })}
+              </div>
+            </div>
+          );
+        })}
+      </div>
+
+      <div className="mt-4 grid gap-3 sm:grid-cols-2">
+        <div>
+          <label className="text-xs font-medium text-neutral-500">ترتیب تلاش ربات‌ها</label>
+          <input className={`${inputCls} mt-1`} dir="ltr" value={order} onChange={(e) => setOrder(e.target.value)} />
+          <p className="mt-1 text-[11px] text-neutral-400">با کاما: groq,huggingface,cloudflare,deepgram,openai</p>
+        </div>
+        <div>
+          <label className="text-xs font-medium text-neutral-500">موتور پیش‌فرض صوت (setting قدیمی)</label>
+          <select className={`${inputCls} mt-1`} value={voiceProvider} onChange={(e) => setVoiceProvider(e.target.value)}>
+            <option value="mock">mock (بدون سرویس بیرونی)</option>
+            <option value="openai">openai</option>
+          </select>
+          <p className="mt-1 text-[11px] text-neutral-400">نسخهٔ جدید از زنجیرهٔ ربات‌ها و «ترتیب تلاش» استفاده می‌کند.</p>
+        </div>
+      </div>
+
+      {msg && (
+        <p className={`mt-4 rounded-xl px-4 py-3 text-sm ${msg.ok ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300" : "bg-red-50 text-red-600 dark:bg-red-900/30 dark:text-red-300"}`}>
+          {msg.text}
+        </p>
+      )}
+
+      <button onClick={save} disabled={saving} className="mt-4 rounded-xl bg-gradient-to-l from-pink-600 to-purple-600 px-5 py-2.5 text-sm font-black text-white shadow-md shadow-pink-500/20 transition hover:opacity-95 disabled:opacity-50">
+        {saving ? "در حال ذخیره..." : "💾 ذخیره کلیدهای صوتی"}
+      </button>
+    </section>
+  );
+}
