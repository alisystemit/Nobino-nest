diff --git a/src/lib/rate-limit.ts b/src/lib/rate-limit.ts
new file mode 100644
index 0000000..9b88a6b
--- /dev/null
+++ b/src/lib/rate-limit.ts
@@ -0,0 +1,36 @@
+/**
+ * محدودساز سادهٔ درون‌حافظه‌ای برای مسیرهای عمومی AI (ضد سوءاستفاده/هزینهٔ سرویس).
+ * در محیط چند-نسخه‌ای فقط سرانهٔ هر نمونه را محدود می‌کند؛ برای نوبت‌دهی عمومی کافی است.
+ */
+type Bucket = { count: number; resetAt: number };
+const buckets = new Map<string, Bucket>();
+
+export interface RateCheck {
+  ok: boolean;
+  retryAfterSec: number;
+}
+
+export function checkRate(key: string, limit: number, windowMs: number): RateCheck {
+  const now = Date.now();
+  const hit = buckets.get(key);
+  if (!hit || hit.resetAt <= now) {
+    buckets.set(key, { count: 1, resetAt: now + windowMs });
+    if (buckets.size > 5000) {
+      // پاکسازی opportunist تا حافظه پر نشود
+      for (const [k, v] of buckets) if (v.resetAt <= now) buckets.delete(k);
+    }
+    return { ok: true, retryAfterSec: 0 };
+  }
+  if (hit.count >= limit) {
+    return { ok: false, retryAfterSec: Math.max(1, Math.ceil((hit.resetAt - now) / 1000)) };
+  }
+  hit.count += 1;
+  return { ok: true, retryAfterSec: 0 };
+}
+
+/** کلید محدودسازی از روی IP کاربر (ترجیحاً x-forwarded-for) */
+export function rateKeyFromRequest(req: Request, prefix: string): string {
+  const fwd = req.headers.get("x-forwarded-for");
+  const ip = (fwd ? fwd.split(",")[0]!.trim() : "") || req.headers.get("x-real-ip") || "unknown";
+  return `${prefix}:${ip}`;
+}
