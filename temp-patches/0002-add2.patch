--- /dev/null
+++ b/src/app/api/admin/ai/status/route.ts
@@ -0,0 +1,35 @@
+import { requireRole } from "@/lib/auth/guards";
+import { getSetting } from "@/lib/settings";
+import { listLlmProviders, resolveLlm, aiSwitchOn } from "@/lib/ai/llm";
+import { listSttProviders } from "@/lib/ai/stt";
+import { json, apiError } from "@/lib/utils";
+
+/**
+ * وضعیت هوش مصنوعی برای پنل سوپرادمین.
+ * هیچ کلیدی برگردانده نمی‌شود؛ فقط «تنظیم شده/نشده» و ماسک کوتاه.
+ */
+export async function GET() {
+  try {
+    await requireRole(["ADMIN"]);
+
+    const [providers, stt, active, enabled, switchOn] = await Promise.all([
+      listLlmProviders(),
+      listSttProviders(),
+      resolveLlm(),
+      getSetting("ai.provider"),
+      aiSwitchOn(),
+    ]);
+
+    return json({
+      success: true,
+      switchOn,
+      provider: (active?.provider ?? (providers.find((p) => p.keySet)?.id ?? null)),
+      preferredProvider: enabled ?? "",
+      active: active ? { provider: active.provider, model: active.model, baseUrl: active.baseUrl } : null,
+      llmProviders: providers,
+      sttProviders: stt,
+    });
+  } catch (err) {
+    return apiError(err);
+  }
+}
