+import test from "node:test";
+import assert from "node:assert/strict";
+
+import { normalizeChatUrl, maskKey, llmHttpHint, pickStringFields, cleanGeneratedText } from "../src/lib/ai/llm-helpers.ts";
+import { checkRate } from "../src/lib/rate-limit.ts";
+
+/** آدرس completions از هر شکل base_url ساخته شود */
+test("normalizeChatUrl همهٔ شکل‌های آدرس را به chat/completions می‌رساند", () => {
+  assert.equal(normalizeChatUrl("https://api.openai.com/v1"), "https://api.openai.com/v1/chat/completions");
+  assert.equal(normalizeChatUrl("https://api.groq.com/openai/v1/"), "https://api.groq.com/openai/v1/chat/completions");
+  assert.equal(normalizeChatUrl("http://localhost:11434/v1"), "http://localhost:11434/v1/chat/completions");
+  assert.equal(normalizeChatUrl("https://example.com/api/chat/completions"), "https://example.com/api/chat/completions");
+  assert.equal(normalizeChatUrl("https://api.deepseek.com"), "https://api.deepseek.com/chat/completions");
+  assert.equal(normalizeChatUrl(""), "https://api.openai.com/v1/chat/completions");
+});
+
+/** کلید محرمانه هرگز کامل در پاسخ API برنمی‌گردد */
+test("maskKey فقط چند کاراکتر اول و آخر کلید را نشان می‌دهد", () => {
+  const masked = maskKey("sk-proj-abcdefghijklmnopqrstuvwxyz");
+  assert.ok(masked.includes("•"));
+  assert.ok(!masked.includes("abcdefghijklmnopqrstuvwxyz"));
+  assert.equal(masked.length < "sk-proj-abcdefghijklmnopqrstuvwxyz".length, true);
+});
+
+/** پیام‌های خطای فارسی برای کدهای رایج سرویس‌دهنده */
+test("llmHttpHint کدهای اصلی را به فارسی توضیح می‌دهد", () => {
+  assert.match(llmHttpHint(401, ""), /کلید API نامعتبر/);
+  assert.match(llmHttpHint(429, ""), /محدودیت نرخ/);
+  assert.match(llmHttpHint(503, ""), /قطع است/);
+});
+
+/** خروجی JSON مدل فقط فیلدهای متنیِ پر را نگه می‌دارد */
+test("pickStringFields فیلدهای خالی/غیرمتنی را حذف می‌کند", () => {
+  const out = pickStringFields({ name: " سارا ", phone: "", time: 12, date: "2026-10-31", extra: "x" }, ["name", "phone", "time", "date"]);
+  assert.deepEqual(out, { name: "سارا", date: "2026-10-31" });
+  assert.deepEqual(pickStringFields(null, ["name"]), {});
+});
+
+/** محدودساز نرخ: زیر سقف آزاد، بالای سقف مسدود */
+test("checkRate بعد از رسیدن به سقف، درخواست را با retryAfter مسدود می‌کند", () => {
+  const key = `test-rate-${Date.now()}`;
+  assert.equal(checkRate(key, 2, 60_000).ok, true);
+  assert.equal(checkRate(key, 2, 60_000).ok, true);
+  const third = checkRate(key, 2, 60_000);
+  assert.equal(third.ok, false);
+  assert.ok(third.retryAfterSec > 0);
+});
+
+/** متن تولیدشده بدون نقل‌قول و فاصلهٔ اضافه به کاربر نشان داده می‌شود */
+test("cleanGeneratedText نقل‌قول و فاصله‌های دوبل را حذف می‌کند", () => {
+  assert.equal(cleanGeneratedText('  «کوتاهی مو با کیفیت  حرفه‌ای»  '), "کوتاهی مو با کیفیت حرفه‌ای");
+});
