@@ -0,0 +1,27 @@
+import { requireRole } from "@/lib/auth/guards";
+import { testLlmConnection } from "@/lib/ai/llm";
+import { json } from "@/lib/utils";
+
+/**
+ * تست واقعی اتصال هوش مصنوعی با سرویس‌دهندهٔ فعال (یک پرامپت کوتاه).
+ * فقط برای سوپرادمین؛ هیچ کلیدی در پاسخ نمی‌آید.
+ */
+export async function POST() {
+  try {
+    await requireRole(["ADMIN"]);
+    const result = await testLlmConnection();
+    if (!result.ok) {
+      return json({ success: false, error: result.error ?? "اتصال برقرار نشد", provider: result.provider, model: result.model }, { status: 200 });
+    }
+    return json({
+      success: true,
+      provider: result.provider,
+      model: result.model,
+      latencyMs: result.latencyMs,
+      sample: result.sample,
+      message: `اتصال با «${result.provider}» (${result.model}) برقرار شد ✅`,
+    });
+  } catch {
+    return json({ success: false, error: "خطای غیرمنتظره در تست اتصال" }, { status: 500 });
+  }
+}
