index 0000000..1af6d29
--- /dev/null
+++ b/src/lib/ui/subscriptions-view.ts
@@ -0,0 +1,234 @@
+/**
+ * منطق خالصِ نمای «اشتراک‌ها» در پنل سوپرادمین.
+ * خالص، بدون DOM و بدون دیتابیس است تا با `node --test` قابل تست باشد
+ * و هرگز `Date.now()` پنهان در کامپوننت نمی‌شود (تاریخ «امروز» را فراخوان می‌دهد).
+ */
+
+export type SubViewRow = {
+  id: string;
+  status: string;
+  period: string;
+  startsAt: string;
+  endsAt: string;
+  createdAt: string;
+  autoRenew?: boolean;
+  cancelledAt?: string | null;
+  salonId?: string | null;
+  packageId?: string | null;
+  salon?: {
+    name?: string | null;
+    slug?: string | null;
+    phone?: string | null;
+    city?: string | null;
+    plan?: string | null;
+    isApproved?: boolean | null;
+    isActive?: boolean | null;
+    subscriptionEndsAt?: string | null;
+    trialEndsAt?: string | null;
+  } | null;
+  ownerName?: string | null;
+  ownerPhone?: string | null;
+  package?: {
+    name?: string | null;
+    plan?: string | null;
+    price?: number | null;
+    yearlyPrice?: number | null;
+    durationDays?: number | null;
+    isActive?: boolean | null;
+  } | null;
+  /** مجموع فاکتورهای پرداخت‌شدهٔ وصل به اشتراک (تومان) و تعدادشان */
+  paidTotal?: number;
+  paidCount?: number;
+  pastEnd?: boolean;
+};
+
+/** دسته‌بندی نمایشی هر اشتراک — اولویت با وضعیت ثبت‌شده در دیتابیس است */
+export type SubBucket = "active" | "expiring" | "overdue" | "ended" | "suspended" | "cancelled";
+
+export const BUCKET_META: Record<SubBucket, { label: string; tone: "ok" | "warn" | "bad" | "neutral" }> = {
+  active: { label: "فعال", tone: "ok" },
+  expiring: { label: "در آستانهٔ پایان", tone: "warn" },
+  overdue: { label: "زمان‌گذشتهٔ فعال", tone: "warn" },
+  ended: { label: "منقضی", tone: "neutral" },
+  suspended: { label: "تعلیق‌شده", tone: "bad" },
+  cancelled: { label: "لغوشده", tone: "bad" },
+};
+
+const DAY_MS = 86_400_000;
+
+function toDate(iso: string | null | undefined): Date | null {
+  if (!iso) return null;
+  const d = new Date(iso);
+  return Number.isNaN(d.getTime()) ? null : d;
+}
+
+/**
+ * روزهای باقی‌مانده (سقفِ روز کامل؛ عدد منفی = گذشته).
+ * مثال: ۶ ساعت باقی‌مانده ⇒ ۱ روز، و ۶ ساعت گذشته ⇒ -۱ روز.
+ */
+export function daysLeft(endsAt: string | null | undefined, now: Date): number | null {
+  const end = toDate(endsAt);
+  if (!end) return null;
+  return Math.ceil((end.getTime() - now.getTime()) / DAY_MS);
+}
+
+/** دستهٔ نمایشی یک اشتراک بر اساس وضعیت + زمان باقی‌مانده */
+export function subBucket(status: string, days: number | null): SubBucket {
+  const s = (status || "").toUpperCase();
+  if (s === "SUSPENDED") return "suspended";
+  if (s === "CANCELLED") return "cancelled";
+  if (s === "EXPIRED") return "ended";
+  if (s === "ACTIVE") {
+    if (days == null) return "active";
+    if (days < 0) return "overdue";
+    if (days <= 7) return "expiring";
+    return "active";
+  }
+  // وضعیت ناشناخته: اگر تاریخ پایان نگفته باشد فعال حساب می‌شود تا گم نشود
+  return "active";
+}
+
+export type SubSummary = {
+  total: number;
+  /** فعال سالم (بیش از ۷ روز تا پایان) */
+  active: number;
+  /** فعال با ۷ روز یا کمتر تا پایان — زیرمجموعهٔ active */
+  expiring: number;
+  /** وضعیت ACTIVE ولی تاریخ پایان گذشته */
+  overdue: number;
+  ended: number;
+  suspended: number;
+  cancelled: number;
+  autoRenewOn: number;
+  /** درآمد برآوردی یک دوره از اشتراک‌های فعال (تومان) */
+  activeMonthlyValue: number;
+  /** تعداد اشتراک‌های فعالی که پکیجشان دیگر در دسترس نیست/حذف شده */
+  orphanPackage: number;
+};
+
+/** آمار کلی — بر اساس فهرست کامل دریافت‌شده از API حساب می‌شود */
+export function summarizeSubs(rows: SubViewRow[], now: Date): SubSummary {
+  const out: SubSummary = {
+    total: rows.length,
+    active: 0,
+    expiring: 0,
+    overdue: 0,
+    ended: 0,
+    suspended: 0,
+    cancelled: 0,
+    autoRenewOn: 0,
+    activeMonthlyValue: 0,
+    orphanPackage: 0,
+  };
+  for (const r of rows) {
+    const days = daysLeft(r.endsAt, now);
+    const b = subBucket(r.status, days);
+    if (b === "active" || b === "expiring") {
+      out.active += 1;
+      if (b === "expiring") out.expiring += 1;
+      out.activeMonthlyValue += priceForPeriod(r, r.period);
+      if (!r.package?.name) out.orphanPackage += 1;
+    } else if (b === "overdue") {
+      out.overdue += 1;
+    } else if (b === "ended") {
+      out.ended += 1;
+    } else if (b === "suspended") {
+      out.suspended += 1;
+    } else {
+      out.cancelled += 1;
+    }
+    if (r.autoRenew) out.autoRenewOn += 1;
+  }
+  return out;
+}
+
+/** قیمت یک دوره از اشتراک (سالانه از yearlyPrice، در غیر این صورت ماهانه) */
+export function priceForPeriod(row: SubViewRow, period: string | null | undefined): number {
+  const p = row.package;
+  if (!p) return 0;
+  const monthly = Number(p.price ?? 0) || 0;
+  if ((period || "").toUpperCase() === "YEARLY") return Number(p.yearlyPrice ?? 0) || monthly * 12;
+  return monthly;
+}
+
+export type SubFilter = {
+  /** خالی = همهٔ دسته‌ها */
+  bucket?: string;
+  /** خالی = همهٔ پلن‌ها (FREE/BASIC/PRO/ENTERPRISE) */
+  plan?: string;
+  /** خالی = همهٔ دوره‌ها */
+  period?: string;
+  /** جست‌وجوی متن آزاد در نام سالن، slug، تلفن و نام پکیج */
+  q?: string;
+};
+
+function norm(s: string | null | undefined): string {
+  return (s ?? "").toString().trim().toLowerCase();
+}
+
+/** فیلتر + جست‌وجو؛ بدون جانبی‌سازی و پایدار (ترتیب ورودی حفظ می‌شود) */
+export function filterSubs(rows: SubViewRow[], f: SubFilter, now: Date): SubViewRow[] {
+  const q = norm(f.q);
+  const bucket = f.bucket || "";
+  const plan = f.plan || "";
+  const period = f.period || "";
+  return rows.filter((r) => {
+    if (plan && norm(r.package?.plan || r.salon?.plan) !== norm(plan)) return false;
+    if (period && norm(r.period) !== norm(period)) return false;
+    if (bucket) {
+      const b = subBucket(r.status, daysLeft(r.endsAt, now));
+      // «در آستانهٔ پایان» و «زمان‌گذشتهٔ فعال» زیرمجموعهٔ فعال‌اند؛ فیلتر فعال همه را می‌گیرد
+      if (bucket === "active" ? !(b === "active" || b === "expiring" || b === "overdue") : b !== bucket) return false;
+    }
+    if (q) {
+      const hay = [r.salon?.name, r.salon?.slug, r.salon?.phone, r.ownerPhone, r.package?.name].map(norm).join(" ");
+      if (!hay.includes(q)) return false;
+    }
+    return true;
+  });
+}
+
+const BUCKET_PRIORITY: Record<SubBucket, number> = {
+  overdue: 0,
+  expiring: 1,
+  active: 2,
+  suspended: 3,
+  cancelled: 4,
+  ended: 5,
+};
+
+/**
+ * مرت‌سازی برای نمایش: اول موارد نیازمند اقدام (زمان‌گذشته و در آستانهٔ پایان)،
+ * بعد فعال‌ها، و در نهایت تعلیق/لغو/منقضی. داخل هر دسته نزدیک‌ترین پایان اول.
+ */
+export function sortSubsForView(rows: SubViewRow[], now: Date): SubViewRow[] {
+  return [...rows].sort((a, b) => {
+    const pa = BUCKET_PRIORITY[subBucket(a.status, daysLeft(a.endsAt, now))];
+    const pb = BUCKET_PRIORITY[subBucket(b.status, daysLeft(b.endsAt, now))];
+    if (pa !== pb) return pa - pb;
+    const ta = toDate(a.endsAt)?.getTime() ?? Number.POSITIVE_INFINITY;
+    const tb = toDate(b.endsAt)?.getTime() ?? Number.POSITIVE_INFINITY;
+    if (ta !== tb) return ta - tb;
+    return norm(a.salon?.name).localeCompare(norm(b.salon?.name));
+  });
+}
+
+/** توضیح کوتاهِ رنگی‌شده برای کاربر: «۳ روز مانده» / «۵ روز گذشته» */
+export function faRemaining(days: number | null): string {
+  if (days == null) return "—";
+  if (days === 0) return "امروز پایان می‌یابد";
+  if (days < 0) return `${Math.abs(days)} روز گذشته`;
+  return `${days} روز مانده`;
+}
+
+/**
+ * محاسبهٔ تاریخ تمدید (ISO) — همان منطق `activateSubscription`/`renewSubscription`:
+ * دورهٔ سالانه ۳۶۵ روز و ماهانه `durationDays` (پیش‌فرض ۳۰).
+ * اگر اشتراک هنوز منقضی نشده باشد، از تاریخ پایان فعلی اضافه می‌شود (تمدید روی تمدید).
+ */
+export function nextEndsAt(currentEndsAt: string | null | undefined, period: string, durationDays: number | null | undefined, now: Date): string {
+  const days = (period || "").toUpperCase() === "YEARLY" ? 365 : Number(durationDays) > 0 ? Number(durationDays) : 30;
+  const cur = toDate(currentEndsAt);
+  const base = cur && cur.getTime() > now.getTime() ? cur.getTime() : now.getTime();
+  return new Date(base + days * DAY_MS).toISOString();
+}
