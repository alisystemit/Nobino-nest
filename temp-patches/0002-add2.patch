+
+const inputCls =
+  "w-full rounded-xl border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 outline-none transition focus:border-pink-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100";
+const primaryBtn =
+  "rounded-xl bg-gradient-to-l from-pink-600 to-purple-600 px-5 py-2.5 text-sm font-black text-white shadow-md shadow-pink-500/20 transition hover:opacity-95 disabled:opacity-50";
+const ghostBtn =
+  "rounded-xl border border-neutral-300 px-4 py-2.5 text-sm font-bold text-neutral-700 transition hover:bg-neutral-50 disabled:opacity-50 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800";
+
+/** کلیدهایی که این کارت مدیریت می‌کند (در لیست «سایر تنظیمات» تکرار نشوند) */
+export const AI_MANAGED_KEYS = new Set([
+  "ai.enabled",
+  "ai.provider",
+  "ai.model",
+  "ai.custom.base_url",
+  "openai.api_key",
+  "stt.openai.key",
+  "stt.groq.key",
+  "stt.huggingface.key",
+  "stt.cloudflare.key",
+  "stt.cloudflare.account",
+  "stt.deepgram.key",
+  "ai.deepseek.key",
+  "ai.custom.key",
+]);
+
+export default function AiSettingsCard({ onMsg }: { onMsg?: (m: Msg) => void }) {
+  const [loading, setLoading] = useState(true);
+  const [providers, setProviders] = useState<ProviderRow[]>([]);
+  const [stt, setStt] = useState<SttRow[]>([]);
+  const [active, setActive] = useState<{ provider: string; model: string } | null>(null);
+  const [enabled, setEnabled] = useState(true);
+  const [form, setForm] = useState<Record<string, string>>({});
+  const [saving, setSaving] = useState(false);
+  const [testing, setTesting] = useState(false);
+  const [result, setResult] = useState<Msg>(null);
+
+  const load = useCallback(async () => {
+    try {
+      const [statusRes, settingsRes] = await Promise.all([
+        fetch("/api/admin/ai/status"),
+        fetch("/api/admin/settings"),
+      ]);
+      const s = await statusRes.json();
+      if (s.success) {
+        setProviders(s.llmProviders as ProviderRow[]);
+        setStt(s.sttProviders as SttRow[]);
+        setActive(s.active ? { provider: s.active.provider, model: s.active.model } : null);
+        setEnabled(Boolean(s.switchOn));
+      }
+      const all = await settingsRes.json();
+      if (all.success) {
+        const init: Record<string, string> = {};
+        for (const row of all.settings as { key: string; value: string }[]) {
+          if (AI_MANAGED_KEYS.has(row.key)) init[row.key] = row.value;
+        }
+        setForm(init);
+        if (typeof init["ai.provider"] === "string" && init["ai.provider"].trim()) setPreferred(init["ai.provider"].trim());
+        if (init["ai.enabled"]) setEnabled(init["ai.enabled"] !== "false");
+      }
+    } catch {
+      setResult({ ok: false, text: "خطا در بارگذاری تنظیمات هوش مصنوعی" });
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  const [preferred, setPreferred] = useState("");
+  const [mirrorOpenAI, setMirrorOpenAI] = useState(true);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  function setv(key: string, value: string) {
+    setForm((f) => ({ ...f, [key]: value }));
+  }
+
+  async function save() {
+    setSaving(true);
+    setResult(null);
+    const updates: { key: string; value: string; group?: string; type?: string }[] = [];
+
+    updates.push({ key: "ai.enabled", value: enabled ? "true" : "false", group: "ai", type: "select" });
+    updates.push({ key: "ai.provider", value: preferred, group: "ai", type: "select" });
+    const model = (form["ai.model"] ?? "").trim();
+    updates.push({ key: "ai.model", value: model, group: "ai", type: "string" });
+    const baseUrl = (form["ai.custom.base_url"] ?? "").trim();
+    updates.push({ key: "ai.custom.base_url", value: baseUrl, group: "ai", type: "string" });
+
+    for (const p of providers) {
+      const key = keySettingFor(p.id);
+      const v = form[key];
