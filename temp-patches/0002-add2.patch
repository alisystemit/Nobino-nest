diff --git a/tests/subscriptions-view.test.ts b/tests/subscriptions-view.test.ts
new file mode 100644
index 0000000..9c26b2a
--- /dev/null
+++ b/tests/subscriptions-view.test.ts
@@ -0,0 +1,134 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  daysLeft,
+  faRemaining,
+  filterSubs,
+  nextEndsAt,
+  priceForPeriod,
+  sortSubsForView,
+  subBucket,
+  summarizeSubs,
+  type SubViewRow,
+} from "../src/lib/ui/subscriptions-view.ts";
+
+const NOW = new Date("2026-03-01T12:00:00.000Z");
+const DAY = 86_400_000;
+const iso = (offsetDays: number) => new Date(NOW.getTime() + offsetDays * DAY).toISOString();
+
+function row(over: Partial<SubViewRow> & { id: string }): SubViewRow {
+  return {
+    status: "ACTIVE",
+    period: "MONTHLY",
+    startsAt: iso(-10),
+    endsAt: iso(20),
+    createdAt: iso(-10),
+    salon: { name: "سالن ماه", slug: "mah", phone: "02188445566", plan: "BASIC" },
+    ownerPhone: "09120000001",
+    package: { name: "پکیج پایه", plan: "BASIC", price: 300000, yearlyPrice: 3000000, durationDays: 30 },
+    ...over,
+  };
+}
+
+const rows: SubViewRow[] = [
+  row({ id: "healthy", endsAt: iso(20) }),
+  row({ id: "soon", endsAt: iso(3) }),
+  row({ id: "late", status: "ACTIVE", endsAt: iso(-4) }),
+  row({ id: "expired", status: "EXPIRED", endsAt: iso(-30) }),
+  row({ id: "susp", status: "SUSPENDED", endsAt: iso(15) }),
+  row({ id: "canc", status: "CANCELLED", endsAt: iso(9) }),
+  row({ id: "pro", endsAt: iso(5), period: "YEARLY", package: { name: "پکیج حرفه‌ای", plan: "PRO", price: 900000, durationDays: 30 } }),
+  row({ id: "orphan", endsAt: iso(11), package: undefined }),
+];
+
+test("daysLeft: سقف روز کامل و علامت منفی برای گذشته", () => {
+  assert.equal(daysLeft(iso(3), NOW), 3);
+  assert.equal(daysLeft(iso(-2), NOW), -2);
+  // ۶ ساعت مانده ⇒ یک روز (نه صفر) تا کاربر «امروز» نبیند
+  assert.equal(daysLeft(new Date(NOW.getTime() + 6 * 3600_000).toISOString(), NOW), 1);
+  assert.equal(daysLeft(null, NOW), null);
+  assert.equal(daysLeft("not-a-date", NOW), null);
+});
+
+test("subBucket: دسته‌بندی بر اساس وضعیت و زمان باقی‌مانده", () => {
+  assert.equal(subBucket("ACTIVE", 20), "active");
+  assert.equal(subBucket("ACTIVE", 7), "expiring");
+  assert.equal(subBucket("ACTIVE", 0), "expiring");
+  assert.equal(subBucket("ACTIVE", -1), "overdue");
+  assert.equal(subBucket("ACTIVE", null), "active");
+  assert.equal(subBucket("EXPIRED", 40), "ended");
+  assert.equal(subBucket("SUSPENDED", 40), "suspended");
+  assert.equal(subBucket("CANCELLED", 40), "cancelled");
+  assert.equal(subBucket("WEIRD", 40), "active"); // وضعیت ناشناخته گم نمی‌شود
+});
+
+test("summarizeSubs: شمارش دسته‌ها و درآمد برآوردی یک دوره", () => {
+  const s = summarizeSubs(rows, NOW);
+  assert.equal(s.total, 8);
+  // active = فعال‌های نوبت‌دار + درآستانهٔ پایان (expiring زیرمجموعهٔ آن است)
+  assert.equal(s.active, 4);
+  assert.equal(s.expiring, 2);
+  assert.equal(s.overdue, 1);
+  assert.equal(s.ended, 1);
+  assert.equal(s.suspended, 1);
+  assert.equal(s.cancelled, 1);
+  assert.equal(s.orphanPackage, 1);
+  // healthy(300k) + soon(300k) + pro(بدون yearlyPrice ⇒ 900k×12) + orphan(پکیج ندارد ⇒ 0)
+  assert.equal(s.activeMonthlyValue, 300000 + 300000 + 900000 * 12 + 0);
+});
+
+test("priceForPeriod: سالانه از yearlyPrice و در نبودش ۱۲ برابر ماهانه", () => {
+  assert.equal(priceForPeriod(rows[0], "YEARLY"), 3000000);
+  assert.equal(priceForPeriod(rows[0], "MONTHLY"), 300000);
+  assert.equal(priceForPeriod(rows[6], "YEARLY"), 900000 * 12);
+  assert.equal(priceForPeriod(row({ id: "x", package: undefined }), "MONTHLY"), 0);
+});
+
+test("filterSubs: فیلتر فعال شامل درآستانه‌پایان و زمان‌گذشته است", () => {
+  const ids = filterSubs(rows, { bucket: "active" }, NOW).map((r) => r.id);
+  assert.deepEqual(ids.sort(), ["healthy", "late", "orphan", "pro", "soon"].sort());
+  assert.deepEqual(filterSubs(rows, { bucket: "expiring" }, NOW).map((r) => r.id), ["soon", "pro"]);
+  assert.deepEqual(filterSubs(rows, { bucket: "overdue" }, NOW).map((r) => r.id), ["late"]);
+  assert.equal(filterSubs(rows, { bucket: "" }, NOW).length, 8);
+});
+
+test("filterSubs: پلن، دوره و جست‌وجوی متن آزاد (نام سالن/slug/تلفن/پکیج)", () => {
+  assert.deepEqual(filterSubs(rows, { plan: "PRO" }, NOW).map((r) => r.id), ["pro"]);
+  assert.deepEqual(filterSubs(rows, { period: "YEARLY" }, NOW).map((r) => r.id), ["pro"]);
+  // slug سالن «mah» در همهٔ ردیف‌های پیش‌فرض هست، پس همه می‌خورند (جست‌وجو case-insensitive)
+  assert.equal(filterSubs(rows, { q: "MAH" }, NOW).length, 8);
+  // اما جست‌وجوی نام پکیج فقط ردیف‌های همان پکیج را می‌دهد
+  assert.deepEqual(filterSubs(rows, { q: "حرفه‌ای" }, NOW).map((r) => r.id), ["pro"]);
+  assert.deepEqual(filterSubs(rows, { q: "09120000001" }, NOW).length, 8);
+  assert.deepEqual(filterSubs(rows, { q: "دیوانه" }, NOW), []);
+  // ترکیب فیلترها
+  assert.deepEqual(filterSubs(rows, { bucket: "active", q: "حرفه‌ای" }, NOW).map((r) => r.id), ["pro"]);
+});
+
+test("sortSubsForView: اول موارد نیازمند اقدام، سپس فعال‌ها، آخر منقضی‌ها", () => {
+  const before = rows.map((r) => r.id).join(",");
+  const sorted = sortSubsForView(rows, NOW).map((r) => r.id);
+  assert.deepEqual(sorted, ["late", "soon", "pro", "orphan", "healthy", "susp", "canc", "expired"]);
+  assert.equal(rows.map((r) => r.id).join(","), before); // ورودی دست‌نخورده
+});
+
+test("faRemaining: متن فارسی برای مانده/گذشته/امروز", () => {
+  assert.equal(faRemaining(3), "3 روز مانده");
+  assert.equal(faRemaining(-5), "5 روز گذشته");
+  assert.equal(faRemaining(0), "امروز پایان می‌یابد");
+  assert.equal(faRemaining(null), "—");
+});
+
+test("nextEndsAt: تمدید روی پایان فعلی اگر منقضی نشده باشد", () => {
+  const cur = iso(10);
+  const next = new Date(nextEndsAt(cur, "MONTHLY", 30, NOW)).getTime();
+  assert.equal(next, new Date(cur).getTime() + 30 * DAY);
+});
+
+test("nextEndsAt: اشتراک گذشته از «امروز» شمارش می‌کند و دورهٔ سالانه ۳۶۵ روز است", () => {
+  const past = iso(-40);
+  assert.equal(new Date(nextEndsAt(past, "MONTHLY", 30, NOW)).getTime(), NOW.getTime() + 30 * DAY);
+  assert.equal(new Date(nextEndsAt(past, "YEARLY", 30, NOW)).getTime(), NOW.getTime() + 365 * DAY);
+  // durationDays نامعتبر ⇒ پیش‌فرض ۳۰
+  assert.equal(new Date(nextEndsAt(past, "MONTHLY", 0, NOW)).getTime(), NOW.getTime() + 30 * DAY);
+});
