/**
 * Nobino PM2 service template (NestJS edition).
 * install.sh turns this file into deploy/ecosystem.config.cjs by replacing
 * __APP_DIR__ and __PORT__; so edit this file, not the generated output.
 *
 * Start:   pm2 start deploy/ecosystem.config.cjs
 * Status:  pm2 status
 * Logs:    pm2 logs nobino-api
 * Zero-downtime restart: pm2 reload nobino-api
 */
module.exports = {
  apps: [
    {
      name: "nobino-api",
      // Service user — install.sh replaces this from `--user`; without this
      // field, after a server restart the root pm2 daemon cannot bring the app
      // up as the service user (g18).
      user: "__USER__",
      // cwd matters: upload paths and static files are resolved relative to it
      // (public/uploads and frontend/dist).
      cwd: "__APP_DIR__",
      script: "backend/dist/main.js",
      // Single process: @nestjs/schedule cron jobs run in every instance, so
      // cluster/instances > 1 causes duplicate SMS. For horizontal scaling,
      // move cron to a separate service (AUTOMATION_BASE_URL + external cron).
      exec_mode: "fork",
      instances: 1,
      autorestart: true,
      max_memory_restart: "700M",
      watch: false,
      time: true,
      env: {
        NODE_ENV: "production",
        PORT: "__PORT__",
        HOST: "0.0.0.0",
        // The SPA (frontend/dist) is also served on this port; if nginx serves
        // it directly that is harmless (nginx serves the file from disk first).
        SERVE_FRONTEND: "1",
      },
      error_file: "logs/error.log",
      out_file: "logs/out.log",
      merge_logs: true,
      log_date_format: "YYYY-MM-DD HH:mm:ss Z",
      kill_timeout: 8000,
      wait_ready: false,
    },
  ],
};
