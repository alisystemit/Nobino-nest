# ══════════════════════════════════════════════════════════════════
#  Nobino (NestJS edition) — production environment variables
#  Copy:   cp deploy/env.production.example .env
#  Generate a random secret:  openssl rand -base64 32
#  ──────────────────────────────────────────────────────────────────
#  This file lists only what a "server/PaaS" setup needs.
#  Keys for every Iranian payment gateway are in .env.example; copy
#  those over and set their values in this file (or in .env).
# ══════════════════════════════════════════════════════════════════

# ─── 1) Required ───────────────────────────────────────────────────
# PostgreSQL. On a VPS using the database on the same server: localhost:5432.
# ⚠️ This line is ignored by docker compose: the container cannot reach
# localhost, so compose overrides DATABASE_URL and builds it from POSTGRES_*
# and the service name "db". For an external/managed database in compose mode,
# fill in APP_DATABASE_URL (section 11) instead of this line.
DATABASE_URL="postgresql://nobino:CHANGE_ME@localhost:5432/nobino?schema=public"

# Session JWT signing key — in production it must be random and at least 32 bytes
JWT_SECRET="CHANGE_ME_openssl_rand_base64_32"
JWT_EXPIRES_IN="7d"

# Public site domain. Use the correct protocol; Secure cookies are inferred from it.
APP_URL="https://nobino.ir"
SITE_URL="https://nobino.ir"

# Root domain for salon subdomains: mah.nobino.ir
# (the canonical form of salon addresses; QR codes and the install shortcut use it)
ROOT_DOMAIN="nobino.ir"

# Alias domains (the same site on several domains). Separate with commas; empty = no aliases.
# The first domain is always ROOT_DOMAIN; salon subdomains are served only on it.
EXTRA_DOMAINS=""

# ─── 2) Port and SPA serving ────────────────────────────────────────
# PaaS platforms usually set PORT themselves; on a VPS leave 3100 (nginx sits in front).
PORT=3100
HOST=0.0.0.0
# 1 = the backend also serves frontend/dist on this port (required for single-port PaaS).
# On a VPS with nginx, nginx serves the files directly and this value is harmless.
SERVE_FRONTEND=1
# Database preparation at boot: auto | migrate | push | skip
# auto = migrate deploy if prisma/migrations exists, otherwise db push
DB_SETUP=auto
# Disable automatic prerender after boot (faster boot): 0/1
PRERENDER_ON_BOOT=1
# SPA folder served by the backend. Empty = find frontend/dist automatically
# (several candidate paths are checked). Only needed for special layouts (mono-repo/CDN).
SPA_DIST=""
# 1 = disable SPA serving; only the API comes up (for setups where nginx serves the files).
SPA_DISABLED=0
# 1 = make paas-start skip the build (when the build output is already in the image/source).
SKIP_BUILD=0
# API address called by prerender at boot. Empty = http://127.0.0.1:$PORT (the container itself).
PRERENDER_API=""
# 1 = allow generating SEO pages against the local address (by default local canonical/sitemap
# are not written so a test address does not get burned in Google; only for previewing locally).
PRERENDER_ALLOW_LOCAL=0
# Demo seed at boot (scripts/paas-start.mjs → prisma/seed.mjs). This seed creates
# admin 09120000000 with the default password Admin@1234, so it has no effect on
# production unless you also set ALLOW_PROD_SEED=1. In production: 0/0.
AUTO_SEED=0
ALLOW_PROD_SEED=0

# ─── 3) CORS / cookies ──────────────────────────────────────────────
# Leave empty if the SPA and API share an origin (the normal case).
# For separate domains: a comma-separated list
CORS_ORIGIN=""
# Empty = automatic from X-Forwarded-Proto. Only set false for a test HTTP setup.
AUTH_COOKIE_SECURE=""

# ─── 4) Cron jobs ───────────────────────────────────────────────────
# In-process cron jobs run inside the Nest process (@nestjs/schedule) and need
# this secret to protect /api/cron/*. If it is empty, cron jobs will not run.
CRON_SECRET="CHANGE_ME_another_random_secret"
# Address the external cron (crontab with curl) uses to call the /api/cron routes.
# On a VPS this is the site's own domain.
AUTOMATION_BASE_URL="https://nobino.ir"

# ─── 5) Frontend build variables (Vite) ─────────────────────────────
# These are baked into the bundle during `vite build`; after changing them,
# rebuild the frontend (node scripts/build-release.mjs --skip-install).
VITE_ROOT_DOMAIN="nobino.ir"
VITE_SITE_URL="https://nobino.ir"
VITE_APP_URL="https://nobino.ir"
# These two only affect development (vite dev / npm run dev); they do nothing in a build:
#  VITE_API_PROXY = /api proxy target in the dev server (default http://localhost:3100)
#  VITE_PORT      = frontend dev server port (default 5175)
VITE_API_PROXY=""
VITE_PORT=""

# ─── 6) SMS ─────────────────────────────────────────────────────────
# kavenegar | smsdotir | arpano | farazsms | ghasedak | melipayamak |
# iransms | payamresan | nakalaya | mobilesms | mock
# (mock = logging only; for internal testing). Only the variables for your chosen
# provider are needed; these are intentionally not validated by the backend zod
# schema and providers.ts reads them directly from the environment
# (backend/src/lib/sms/providers.ts).
SMS_PROVIDER="kavenegar"
KAVENEGAR_API_KEY=""
SMSDOTIR_API_KEY=""
SMSDOTIR_SENDER=""
ARPANO_USERNAME=""
ARPANO_PASSWORD=""
ARPANO_FROM=""
FARAZSMS_USERNAME=""
FARAZSMS_PASSWORD=""
FARAZSMS_FROM=""
GHASEDAK_API_KEY=""
GHASEDAK_SENDER=""
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_FROM=""
IRANSMS_API_KEY=""
PAYAMRESAN_API_KEY=""
NAKALAYA_API_KEY=""
MOBILESMS_API_KEY=""

# ─── 7) Smart voice (voice booking) ─────────────────────────────────
# openai | mock
VOICE_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="whisper-1"
# Local Shenava model (sherpa-onnx) — downloaded automatically at boot (AUTO_ASR=0 disables it)
SHENAVA_MODEL_DIR=""
FFMPEG_PATH=""
AUTO_ASR="1"

# ─── 8) Smart text (LLM) ────────────────────────────────────────────
# Whichever key is filled in first is the one the "AI" panel selects
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
AI_CUSTOM_API_KEY=""
AI_CUSTOM_BASE_URL=""

# ─── 9) Payments ────────────────────────────────────────────────────
# sandbox = full simulation; only for initial setup. In production
# PAYMENT_SANDBOX must be false (bootstrap also aborts with PAYMENT_SANDBOX=true).
PAYMENT_DEFAULT_GATEWAY="sandbox"
PAYMENT_SANDBOX="false"
# Gateway callback URL (absolute, no trailing /). It must be reachable from outside.
PAYMENT_CALLBACK_BASE="https://nobino.ir/api/payments/callback"
# Copy gateway keys from .env.example; quick sample:
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"
PASARGAD_TERMINAL_ID=""
PASARGAD_USERNAME=""
PASARGAD_PASSWORD=""
PASARGAD_SHA_KEY=""
PASARGAD_SANDBOX="false"
NEXTPAY_MERCHANT_ID=""
NEXTPAY_API_KEY=""
NEXTPAY_SANDBOX="false"
VANAK_TERMINAL_ID=""
VANAK_MERCHANT_ID=""
VANAK_USERNAME=""
VANAK_PASSWORD=""
VANAK_SANDBOX="false"
# When no dedicated key is set, these four gateways read the shared PSP_API_KEY /
# PSP_MERCHANT_ID (backend/src/lib/payments/gateways/).
PAYIR_API_KEY=""
IDPAY_API_KEY=""
AMANAT_API_KEY=""
ZIBAL_API_KEY=""
ZIBAL_MERCHANT_ID=""
# Other bank gateways — full list in backend/src/lib/payments/gateway-config.ts
# (registry). They are not listed one by one in this file because the same
# credentials can be set from the super admin panel, and dynamic settings take
# priority:
#   payments.<gateway>.<field>   example: payments.mellat.terminal_id
# Environment variables (defaults, used when there is no panel setting):
#   Mellat          MELLAT_TERMINAL_ID / MELLAT_USERNAME / MELLAT_PASSWORD / MELLAT_SANDBOX
#   Saman           SAMAN_TERMINAL_ID / SAMAN_MERCHANT_ID / SAMAN_PASSWORD / SAMAN_SANDBOX
#   Parsian         PARSIAN_USERNAME / PARSIAN_SANDBOX
#   Asan Pardakht   ASANPARDASHT_MERCHANT_ID / ASANPARDASHT_PIN1 / ASANPARDASHT_PIN2 / ASANPARDASHT_SANDBOX
#   PardashtNet     PARDASHTNET_API_KEY / PARDASHTNET_MERCHANT_ID / PARDASHTNET_SANDBOX
#   Behpardakht     BEHPARDAKHT_MERCHANT_ID (+ the same MELLAT_USERNAME/PASSWORD) / BEHPARDAKHT_SANDBOX
#   Sadad (Saderat) SADAD_TERMINAL_ID / SADAD_MERCHANT_ID / SADAD_SHA_KEY / SADAD_SANDBOX
#   IranKish        IRANKISH_TERMINAL_ID / IRANKISH_MERCHANT_ID / IRANKISH_SHA_KEY / IRANKISH_SANDBOX
#   Mabna           MABNA_TERMINAL_ID / MABNA_MERCHANT_ID / MABNA_SHA_KEY / MABNA_SANDBOX
#   Cetab           CETAB_TERMINAL_ID / CETAB_MERCHANT_ID / CETAB_SHA_KEY / CETAB_SANDBOX

# ─── 10) File storage (audio and gallery) ───────────────────────────
# Without a token, files are stored on the server disk under public/uploads
# (always mount a volume in Docker, otherwise they are lost on rebuild).
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# ─── 11) docker compose: build an internal DATABASE_URL ─────────────
# Only needed when you use docker-compose (compose puts these into the final
# DATABASE_URL and prefers it over this file's DATABASE_URL, because localhost
# inside the container cannot reach the database). Change the password.
POSTGRES_DB="nobino"
POSTGRES_USER="nobino"
POSTGRES_PASSWORD="CHANGE_ME_strong_password"
APP_PORT=3100
# External/managed database, reached from inside the container. If set, compose no
# longer builds an address from POSTGRES_* and passes this value to the container.
# Leave empty to use compose's own database.
# Example: postgresql://user:pass@db.example.com:5432/nobino?schema=public&sslmode=require
APP_DATABASE_URL=""

# ─── 12) Rate limits and code validation (optional; defaults are safe) ──
# Priority is always: super admin panel setting ← environment variable ← code default.
# ⚠️ If you leave a line empty, some places read empty as "zero", so either give
# a value or comment out the whole line. Defaults in parentheses are read from the code.
# Number of OTP sends to one number and the lock duration (minutes) after hitting the cap:
OTP_MAX_SENDS=3
OTP_LOCK_MINUTES=300
# AI chat request cap per IP (per minute, default 8) and per salon (per day, 400):
#AI_CHAT_RATE_PER_MINUTE=8
#AI_CHAT_RATE_PER_DAY=400
# Booking hold cap per IP (per minute, default 6) and active holds per salon (default 30):
#HOLD_RATE_PER_MINUTE=6
#HOLD_MAX_ACTIVE_PER_SALON=30
# Voice transcription cap per hour (default 40) and allowed audio file size (bytes;
# otherwise the panel setting upload.voice_max_mb):
#VOICE_RATE_PER_HOUR=40
#VOICE_MAX_UPLOAD_BYTES=

# ─── 13) Create the first super admin (scripts/create-admin.mjs) ────
# To keep the password out of shell history, fill in this section's variables and then run:
#   node scripts/create-admin.mjs
# (These are read only by that script; the server does not need them.)
ADMIN_PHONE=""
ADMIN_PASSWORD=""
ADMIN_EMAIL=""
ADMIN_NAME="Site Admin"

# ─── 14) Build a release (scripts/build-release.mjs) ────────────────
# The smoke test starts the server temporarily on this port (default 3977); change
# it if the port is busy. SMOKE_DB_REQUIRED=1 makes a missing database fail the
# build (instead of warning). SMOKE_PRELOAD is only for environments without PostgreSQL.
SMOKE_PORT=3977
SMOKE_DB_REQUIRED=0
SMOKE_PRELOAD=""
