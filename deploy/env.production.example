# ══════════════════════════════════════════════════════════════════
#  Nobino (نسخهٔ NestJS) — متغیرهای محیطی پروداکشن
#  کپی:   cp deploy/env.production.example .env
#  ساخت رمز تصادفی:  openssl rand -base64 32
#  ──────────────────────────────────────────────────────────────────
#  این فایل فقط آنچه برای «سرور/PaaS» لازم است را فهرست می‌کند.
#  کلید همهٔ درگاه‌های پرداخت ایرانی در .env.example است؛ همان‌ها را
#  کپی کنید و در این فایل (یا در .env) مقدار بدهید.
# ══════════════════════════════════════════════════════════════════

# ─── ۱) ضروری ──────────────────────────────────────────────────────
# PostgreSQL. روی VPS با دیتابیس همان سرور: localhost:5432.
# ⚠️ در docker compose این خط استفاده نمی‌شود: کانتینر نمی‌تواند localhost را
# ببیند، پس compose مقدار DATABASE_URL را نادیده می‌گیرد و آن را از POSTGRES_*
# و نام سرویس «db» می‌سازد. برای دیتابیس بیرونی/managed در حالت compose، به‌جای
# این خط، APP_DATABASE_URL را (بخش ۱۱) پر کنید.
DATABASE_URL="postgresql://nobino:CHANGE_ME@localhost:5432/nobino?schema=public"

# امضای JWT نشست‌ها — در پروداکشن حتماً تصادفی و حداقل ۳۲ نویز باشد
JWT_SECRET="CHANGE_ME_openssl_rand_base64_32"
JWT_EXPIRES_IN="7d"

# دامنهٔ عمومی سایت. پروتکل را درست بگذارید؛ کوکی Secure از همین تشخیص داده می‌شود.
APP_URL="https://nobino.ir"
SITE_URL="https://nobino.ir"

# دامنهٔ ریشهٔ ساب‌دامین سالن‌ها: mah.nobino.ir
# (نسخهٔ canonical آدرس سالن‌ها؛ QR و میان‌بر نصب از همین استفاده می‌کنند)
ROOT_DOMAIN="nobino.ir"

# ─── ۲) پورت و سرو SPA ─────────────────────────────────────────────
# PaaS معمولاً PORT را خودش ست می‌کند؛ روی VPS 3100 رها کنید (nginx جلویش است).
PORT=3100
HOST=0.0.0.0
# 1 = بک‌اند، frontend/dist را هم از همین پورت سرو می‌کند (لازم برای PaaS تک‌پورت).
# روی VPS با nginx، nginx فایل‌ها را مستقیم می‌دهد و این مقدار ضرری ندارد.
SERVE_FRONTEND=1
# آماده‌سازی دیتابیس هنگام بوت: auto | migrate | push | skip
# auto = اگر prisma/migrations بود migrate deploy، وگرنه db push
DB_SETUP=auto
# غیرفعال کردن prerender خودکار بعد از بوت (سرعت‌بخشی بوت): 0/1
PRERENDER_ON_BOOT=1
# پوشهٔ SPA که بک‌اند سرو می‌کند. خالی = خودش frontend/dist را پیدا می‌کند
# (چند مسیر نامزد را بررسی می‌کند). فقط برای ساختارهای خاص (mono-repo/CDN) لازم است.
SPA_DIST=""
# 1 = سرو SPA خاموش؛ فقط API بالا می‌آید (برای حالتی که nginx فایل‌ها را می‌دهد).
SPA_DISABLED=0
# 1 = paas-start ساخت را رد کند (وقتی خروجی build از قبل در ایمیج/سورس است).
SKIP_BUILD=0
# نشانی API که prerender در بوت صدا می‌زند. خالی = http://127.0.0.1:$PORT (خودِ کانتینر).
PRERENDER_API=""
# 1 = ساخت صفحات سئو روی نشانی لوکال را بپذیرید (پیش‌فرض canonical/sitemap لوکال
# نوشته نمی‌شود تا نشانی تستی در گوگل سوخته نشود؛ فقط برای دیدن نتیجه در لوکال).
PRERENDER_ALLOW_LOCAL=0
# بذر دیمو هنگام بوت (scripts/paas-start.mjs → prisma/seed.mjs). این seed ادمین
# 09120000000 با رمز پیش‌فرض Admin@1234 می‌سازد، پس روی production بی‌اثر است
# مگر ALLOW_PROD_SEED=1 را هم بگذارید. در پروداکشن: 0/0.
AUTO_SEED=0
ALLOW_PROD_SEED=0

# ─── ۳) CORS / کوکی ────────────────────────────────────────────────
# اگر SPA و API هم‌مبدأ هستند (حالت عادی) خالی بگذارید.
# برای جدا بودن دامنه‌ها: لیست جداشده با کاما
CORS_ORIGIN=""
# خالی = خودکار از X-Forwarded-Proto. فقط روی HTTPِ تستی false کنید.
AUTH_COOKIE_SECURE=""

# ─── ۴) کران‌ها ─────────────────────────────────────────────────────
# کران‌های داخلی در پروسهٔ Nest (@nestjs/schedule) اجرا می‌شوند و برای
# محافظت از /api/cron/* به این رمز نیاز دارند. اگر خالی باشد کران اجرا نمی‌شود.
CRON_SECRET="CHANGE_ME_another_random_secret"
# آدرسی که کران خارجی (crontab با curl) مسیرهای /api/cron را رویش صدا می‌زند.
# در VPS همان دامنهٔ خودِ سایت.
AUTOMATION_BASE_URL="https://nobino.ir"

# ─── ۵) متغیرهای build فرانت (Vite) ────────────────────────────────
# این‌ها موقع `vite build` داخل باندل جا می‌شوند؛ بعد از تغییر، فرانت را
# دوباره بسازید (node scripts/build-release.mjs --skip-install).
VITE_ROOT_DOMAIN="nobino.ir"
VITE_SITE_URL="https://nobino.ir"
VITE_APP_URL="https://nobino.ir"
# این دو فقط در توسعه (vite dev / npm run dev) مؤثرند، در بیلد چیزی نمی‌سازند:
#  VITE_API_PROXY = مقصد proxy مسیر /api در dev server (پیش‌فرض http://localhost:3100)
#  VITE_PORT      = پورت dev server فرانت (پیش‌فرض 5175)
VITE_API_PROXY=""
VITE_PORT=""

# ─── ۶) پیامک ──────────────────────────────────────────────────────
# kavenegar | smsdotir | arpano | farazsms | ghasedak | melipayamak |
# iransms | payamresan | nakalaya | mobilesms | mock
# (mock = فقط لاگ؛ برای تست داخلی). فقط متغیرهای همان سرویس لازم است؛
# این‌ها عمداً در zod schema بک‌اند اعتبارسنجی نمی‌شوند و providers.ts
# مستقیم از محیط می‌خواندشان (backend/src/lib/sms/providers.ts).
SMS_PROVIDER="kavenegar"
KAVENEGAR_API_KEY=""
SMSDOTIR_API_KEY=""
SMSDOTIR_SENDER=""
ARPANO_USERNAME=""
ARPANO_PASSWORD=""
ARPANO_FROM=""
FARAZSMS_USERNAME=""
FARAZSMS_PASSWORD=""
FARAZSMS_FROM=""
GHASEDAK_API_KEY=""
GHASEDAK_SENDER=""
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_FROM=""
IRANSMS_API_KEY=""
PAYAMRESAN_API_KEY=""
NAKALAYA_API_KEY=""
MOBILESMS_API_KEY=""

# ─── ۷) صدای هوشمند (رزرو صوتی) ────────────────────────────────────
# openai | mock
VOICE_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="whisper-1"

# ─── ۸) متن هوشمند (LLM) ───────────────────────────────────────────
# هرکدام را که کلیدش پر باشد، پنل «هوش مصنوعی» همان را انتخاب می‌کند
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
AI_CUSTOM_API_KEY=""
AI_CUSTOM_BASE_URL=""

# ─── ۹) پرداخت ─────────────────────────────────────────────────────
# sandbox = شبیه‌سازی کامل؛ فقط برای راه‌اندازی اولیه. در پروداکشن
# PAYMENT_SANDBOX=false باشد (bootstrap هم با PAYMENT_SANDBOX=true متوقف می‌شود).
PAYMENT_DEFAULT_GATEWAY="sandbox"
PAYMENT_SANDBOX="false"
# آدرس بازگشت درگاه‌ها (مطلق، بدون / در انتها). باید از بیرون قابل دسترس باشد.
PAYMENT_CALLBACK_BASE="https://nobino.ir/api/payments/callback"
# کلیدهای درگاه‌ها را از .env.example کپی کنید؛ نمونهٔ سریع:
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"
PASARGAD_TERMINAL_ID=""
PASARGAD_USERNAME=""
PASARGAD_PASSWORD=""
PASARGAD_SHA_KEY=""
PASARGAD_SANDBOX="false"
NEXTPAY_MERCHANT_ID=""
NEXTPAY_API_KEY=""
NEXTPAY_SANDBOX="false"
VANAK_TERMINAL_ID=""
VANAK_MERCHANT_ID=""
VANAK_USERNAME=""
VANAK_PASSWORD=""
VANAK_SANDBOX="false"
# این چهار درگاه در نبود کلید اختصاصی، همان PSP_API_KEY / PSP_MERCHANT_ID را
# می‌خوانند (backend/src/lib/payments/gateways/).
PAYIR_API_KEY=""
IDPAY_API_KEY=""
AMANAT_API_KEY=""
ZIBAL_API_KEY=""
ZIBAL_MERCHANT_ID=""
# درگاه‌های بانکی دیگر — فهرست کامل در backend/src/lib/payments/gateway-config.ts
# (registry). نام‌ها یکی‌یکی در این فایل نیامده‌اند چون همان اعتبارنامه از پنل
# سوپرادمین هم قابل ست کردن است و اولویت با تنظیم پویاست:
#   payments.<gateway>.<field>   مثال: payments.mellat.terminal_id
# متغیرهای محیطی (پیش‌فرض، وقتی تنظیم پنل نیست):
#   Mellat          MELLAT_TERMINAL_ID / MELLAT_USERNAME / MELLAT_PASSWORD / MELLAT_SANDBOX
#   Saman           SAMAN_TERMINAL_ID / SAMAN_MERCHANT_ID / SAMAN_PASSWORD / SAMAN_SANDBOX
#   Parsian         PARSIAN_USERNAME / PARSIAN_SANDBOX
#   Asan Pardakht   ASANPARDASHT_MERCHANT_ID / ASANPARDASHT_PIN1 / ASANPARDASHT_PIN2 / ASANPARDASHT_SANDBOX
#   PardashtNet     PARDASHTNET_API_KEY / PARDASHTNET_MERCHANT_ID / PARDASHTNET_SANDBOX
#   Behpardakht     BEHPARDAKHT_MERCHANT_ID (+ همان MELLAT_USERNAME/PASSWORD) / BEHPARDAKHT_SANDBOX
#   Sadad (Saderat) SADAD_TERMINAL_ID / SADAD_MERCHANT_ID / SADAD_SHA_KEY / SADAD_SANDBOX
#   IranKish        IRANKISH_TERMINAL_ID / IRANKISH_MERCHANT_ID / IRANKISH_SHA_KEY / IRANKISH_SANDBOX
#   Mabna           MABNA_TERMINAL_ID / MABNA_MERCHANT_ID / MABNA_SHA_KEY / MABNA_SANDBOX
#   Cetab           CETAB_TERMINAL_ID / CETAB_MERCHANT_ID / CETAB_SHA_KEY / CETAB_SANDBOX

# ─── ۱۰) ذخیرهٔ فایل (صوت و گالری) ─────────────────────────────────
# اگر توکن نباشد، فایل‌ها در public/uploads روی دیسک سرور می‌نشینند
# (در داکر حتماً volume بگذارید، وگرنه با rebuild پاک می‌شوند).
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# ─── ۱۱) docker compose: ساخت DATABASE_URL داخلی ───────────────────
# فقط وقتی از docker-compose استفاده می‌کنید لازم است (compose این‌ها را در
# DATABASE_URL نهایی می‌گذارد و آن را بر مقدار DATABASE_URL این فایل برمی‌گزیند،
# چون localhost داخل کانتینر به دیتابیس نمی‌رسد). رمز را عوض کنید.
POSTGRES_DB="nobino"
POSTGRES_USER="nobino"
POSTGRES_PASSWORD="CHANGE_ME_strong_password"
APP_PORT=3100
# دیتابیس بیرونی/managed از داخل کانتینر. اگر ست شود، compose دیگر از POSTGRES_*
# نشانی نمی‌سازد و همین مقدار را به کانتینر می‌دهد. برای دیتابیس خودِ compose خالی بگذارید.
# مثال: postgresql://user:pass@db.example.com:5432/nobino?schema=public&sslmode=require
APP_DATABASE_URL=""

# ─── ۱۲) حد نرخ و اعتبار کد (اختیاری؛ پیش‌فرض‌ها امن‌اند) ───────────
# اولویت همیشه: تنظیم پنل سوپرادمین ← متغیر محیطی ← پیش‌فرض کد.
# ⚠️ اگر خط را خالی بگذارید، بعضی جاها خالی را «صفر» می‌خوانند؛ پس یا مقدار بدهید
# یا کل خط را کامنت کنید. پیش‌فرض‌های داخل پرانتزها از کد خوانده شده‌اند.
# تعداد ارسال OTP به یک شماره و طول قفل (دقیقه) بعد از رسیدن به سقف:
OTP_MAX_SENDS=3
OTP_LOCK_MINUTES=300
# سقف درخواست چت هوش مصنوعی برای هر IP (در دقیقه، پیش‌فرض 8) و هر سالن (در روز، 400):
#AI_CHAT_RATE_PER_MINUTE=8
#AI_CHAT_RATE_PER_DAY=400
# سقف hold رزرو به ازای هر IP (در دقیقه، پیش‌فرض 6) و هولوهای فعال هر سالن (پیش‌فرض 30):
#HOLD_RATE_PER_MINUTE=6
#HOLD_MAX_ACTIVE_PER_SALON=30
# سقف تبدیل صوت در ساعت (پیش‌فرض 40) و حجم مجاز فایل صوتی (بایت؛ وگرنه
# تنظیم پنل upload.voice_max_mb):
#VOICE_RATE_PER_HOUR=40
#VOICE_MAX_UPLOAD_BYTES=

# ─── ۱۳) ساخت اولین سوپرادمین (scripts/create-admin.mjs) ────────────
# برای اینکه رمز در تاریخ shell نماند، متغیرهای این بخش را پر کنید و بعد:
#   node scripts/create-admin.mjs
# (این‌ها فقط در همان اسکریپت خوانده می‌شوند؛ سرور به آن‌ها نیازی ندارد.)
ADMIN_PHONE=""
ADMIN_PASSWORD=""
ADMIN_NAME="مدیر سایت"

# ─── ۱۴) ساخت release (scripts/build-release.mjs) ───────────────────
# smoke test سرور را روی این پورت موقت بالا می‌آورد (پیش‌فرض 3977)؛ اگر پورت
# اشغال بود عوض کنید. SMOKE_DB_REQUIRED=1 باعث می‌شود نبود دیتابیس بیلد را
# شکست دهد (به‌جای هشدار). SMOKE_PRELOAD تنها برای محیط بدون PostgreSQL است.
SMOKE_PORT=3977
SMOKE_DB_REQUIRED=0
SMOKE_PRELOAD=""
