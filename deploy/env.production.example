# ══════════════════════════════════════════════════════════════════
#  Nobino (نسخهٔ NestJS) — متغیرهای محیطی پروداکشن
#  کپی:   cp deploy/env.production.example .env
#  ساخت رمز تصادفی:  openssl rand -base64 32
#  ──────────────────────────────────────────────────────────────────
#  این فایل فقط آنچه برای «سرور/PaaS» لازم است را فهرست می‌کند.
#  کلید همهٔ درگاه‌های پرداخت ایرانی در .env.example است؛ همان‌ها را
#  کپی کنید و در این فایل (یا در .env) مقدار بدهید.
# ══════════════════════════════════════════════════════════════════

# ─── ۱) ضروری ──────────────────────────────────────────────────────
# PostgreSQL. اگر روی همان سرور است: localhost:5432. اگر در کانتینر
# docker-compose است، به‌جای host نام سرویس «db» می‌آید (compose خودش
# DATABASE_URL را از POSTGRES_* می‌سازد؛ فقط در حالت خارجی این خط را پر کنید).
DATABASE_URL="postgresql://nobino:CHANGE_ME@localhost:5432/nobino?schema=public"

# امضای JWT نشست‌ها — در پروداکشن حتماً تصادفی و حداقل ۳۲ نویز باشد
JWT_SECRET="CHANGE_ME_openssl_rand_base64_32"
JWT_EXPIRES_IN="7d"

# دامنهٔ عمومی سایت. پروتکل را درست بگذارید؛ کوکی Secure از همین تشخیص داده می‌شود.
APP_URL="https://nobino.ir"
SITE_URL="https://nobino.ir"

# دامنهٔ ریشهٔ ساب‌دامین سالن‌ها: mah.nobino.ir
# (نسخهٔ canonical آدرس سالن‌ها؛ QR و میان‌بر نصب از همین استفاده می‌کنند)
ROOT_DOMAIN="nobino.ir"

# ─── ۲) پورت و سرو SPA ─────────────────────────────────────────────
# PaaS معمولاً PORT را خودش ست می‌کند؛ روی VPS 3100 رها کنید (nginx جلویش است).
PORT=3100
HOST=0.0.0.0
# 1 = بک‌اند، frontend/dist را هم از همین پورت سرو می‌کند (لازم برای PaaS تک‌پورت).
# روی VPS با nginx، nginx فایل‌ها را مستقیم می‌دهد و این مقدار ضرری ندارد.
SERVE_FRONTEND=1
# آماده‌سازی دیتابیس هنگام بوت: auto | migrate | push | skip
# auto = اگر prisma/migrations بود migrate deploy، وگرنه db push
DB_SETUP=auto
# غیرفعال کردن prerender خودکار بعد از بوت (سرعت‌بخشی بوت): 0/1
PRERENDER_ON_BOOT=1

# ─── ۳) CORS / کوکی ────────────────────────────────────────────────
# اگر SPA و API هم‌مبدأ هستند (حالت عادی) خالی بگذارید.
# برای جدا بودن دامنه‌ها: لیست جداشده با کاما
CORS_ORIGIN=""
# خالی = خودکار از X-Forwarded-Proto. فقط روی HTTPِ تستی false کنید.
AUTH_COOKIE_SECURE=""

# ─── ۴) کران‌ها ─────────────────────────────────────────────────────
# کران‌های داخلی در پروسهٔ Nest (@nestjs/schedule) اجرا می‌شوند و برای
# محافظت از /api/cron/* به این رمز نیاز دارند. اگر خالی باشد کران اجرا نمی‌شود.
CRON_SECRET="CHANGE_ME_another_random_secret"
# آدرسی که کران خارجی (crontab با curl) مسیرهای /api/cron را رویش صدا می‌زند.
# در VPS همان دامنهٔ خودِ سایت.
AUTOMATION_BASE_URL="https://nobino.ir"

# ─── ۵) متغیرهای build فرانت (Vite) ────────────────────────────────
# این‌ها موقع `vite build` داخل باندل جا می‌شوند؛ بعد از تغییر، فرانت را
# دوباره بسازید (node scripts/build-release.mjs --skip-install).
VITE_ROOT_DOMAIN="nobino.ir"
VITE_SITE_URL="https://nobino.ir"
VITE_APP_URL="https://nobino.ir"

# ─── ۶) پیامک ──────────────────────────────────────────────────────
# kavenegar | smsdotir | mock   (mock = فقط لاگ؛ برای تست داخلی)
SMS_PROVIDER="kavenegar"
KAVENEGAR_API_KEY=""
SMSDOTIR_API_KEY=""
SMSDOTIR_SENDER=""

# ─── ۷) صدای هوشمند (رزرو صوتی) ────────────────────────────────────
# openai | mock
VOICE_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="whisper-1"

# ─── ۸) متن هوشمند (LLM) ───────────────────────────────────────────
# هرکدام را که کلیدش پر باشد، پنل «هوش مصنوعی» همان را انتخاب می‌کند
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
AI_CUSTOM_API_KEY=""
AI_CUSTOM_BASE_URL=""

# ─── ۹) پرداخت ─────────────────────────────────────────────────────
# sandbox = شبیه‌سازی کامل (برای راه‌اندازی اولیه پیشنهاد می‌شود)
PAYMENT_DEFAULT_GATEWAY="sandbox"
PAYMENT_SANDBOX="true"
# آدرس بازگشت درگاه‌ها (مطلق، بدون / در انتها). باید از بیرون قابل دسترس باشد.
PAYMENT_CALLBACK_BASE="https://nobino.ir/api/payments/callback"
# کلیدهای درگاه‌ها را از .env.example کپی کنید؛ نمونهٔ سریع:
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"
PASARGAD_TERMINAL_ID=""
PASARGAD_USERNAME=""
PASARGAD_PASSWORD=""
PASARGAD_SHA_KEY=""
PASARGAD_SANDBOX="true"
NEXTPAY_MERCHANT_ID=""
NEXTPAY_API_KEY=""
NEXTPAY_SANDBOX="true"

# ─── ۱۰) ذخیرهٔ فایل (صوت و گالری) ─────────────────────────────────
# اگر توکن نباشد، فایل‌ها در public/uploads روی دیسک سرور می‌نشینند
# (در داکر حتماً volume بگذارید، وگرنه با rebuild پاک می‌شوند).
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# ─── ۱۱) پایش (اختیاری) ────────────────────────────────────────────
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0"

# ─── ۱۲) docker compose: ساخت DATABASE_URL داخلی ───────────────────
# فقط وقتی از docker-compose استفاده می‌کنید لازم است (compose این‌ها را در
# DATABASE_URL نهایی می‌گذارد). رمز را عوض کنید.
POSTGRES_DB="nobino"
POSTGRES_USER="nobino"
POSTGRES_PASSWORD="CHANGE_ME_strong_password"
APP_PORT=3100
