# =====================================================================
# Nobino — nginx vhost (NestJS + SPA edition)
# Generated by deploy/install.sh; placeholders:
#   __SERVER_NAMES__  list of domains (root domain + its wildcard + alias domains)
#   __DOMAIN__  root domain (nobino.ir)
#   __PORT__    internal NestJS port (3100)
#   __SPA_DIST__  path to frontend/dist
#   __UPLOADS__   path to public/uploads
#   __VOICE__     path to public/voice
# =====================================================================

#  (the upstream block from deploy/nginx/nobino.upstream.conf.part is prepended to this file)
#
# ── HTTP (root domain + all salon subdomains) ───────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAMES__;

    root __SPA_DIST__;
    index index.html;

    access_log /var/log/nginx/nobino.access.log;
    error_log  /var/log/nginx/nobino.error.log warn;

    # Gallery/voice uploads and recorded audio
    # Actual backend caps: avatar 3M, image/media 5M, and audio file 3M (lib/storage +
    # routes/api/voice__transcribe.ts); 40m is just headroom for out-of-range payloads.
    client_max_body_size 12m;

    charset utf-8;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml image/svg+xml font/ttf font/otf;

    # ── API and cron → NestJS backend ──
    location /api/ {
        proxy_pass http://nobino_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    # ── Uploaded files: disk first, then the backend ──
    # ^~ is required: otherwise the regex block below (`\.(xml|txt)$`) matches
    # /uploads/report.txt and the file is served from the SPA root (404).
    location ^~ /uploads/ {
        alias __UPLOADS__/;
        try_files $uri @nobino_backend;
        expires 30d;
        add_header Cache-Control "public";
    }
    location ^~ /voice/ {
        alias __VOICE__/;
        try_files $uri @nobino_backend;
        expires 7d;
    }
    location @nobino_backend {
        proxy_pass http://nobino_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    }

    # ── Vite hashed static assets: one-year cache ──
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri @nobino_backend;
    }
    location ^~ /fonts/ {
        expires 30d;
        try_files $uri @nobino_backend;
    }

    # The PWA service worker must never be cached (otherwise PWA updates never arrive)
    location = /sw.js {
        add_header Cache-Control "no-store, max-age=0";
        types { application/javascript js; }
        try_files $uri @nobino_backend;
    }
    location = /manifest.webmanifest {
        add_header Content-Type "application/manifest+json";
        add_header Cache-Control "public, max-age=300";
        try_files $uri @nobino_backend;
    }
    # HTTP challenge for certificate issuance (if you ever use certbot --nginx)
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type "text/plain";
        allow all;
    }

    # ── SPA: file → prerendered folder (…/index.html) → shell ──
    location / {
        try_files $uri $uri/index.html $uri.html /index.html;
        add_header Cache-Control "no-cache";
    }

    # sitemap/robots are prerendered; ask the backend if they are missing
    location ~* \.(xml|txt)$ {
        try_files $uri @nobino_backend;
        expires 1h;
    }

    # Hidden files and source maps are not served
    location ~ /\. { deny all; }
    location ~ \.map$ { deny all; }
}

# For HTTPS with salon subdomains (a wildcard certificate is required):
#   sudo certbot certonly --manual --preferred-challenges dns -d __DOMAIN__ -d '*.__DOMAIN__'
#   sudo bash deploy/install.sh --domain __DOMAIN__ --tls
# (the 443 block is appended from deploy/nginx/nobino.tls.conf.snippet.)
