# =====================================================================
# Nobino — بلوک HTTPS (افزوده می‌شود به انتهای nobino.conf توسط install.sh --tls)
# جای‌نگهدارها: __DOMAIN__  __TLS_CRT__  __TLS_KEY__
#
# ساب‌دامین‌های سالن‌ها به گواهی wildcard نیاز دارند:
#   sudo certbot certonly --manual --preferred-challenges dns \
#        -d __DOMAIN__ -d '*.__DOMAIN__'
# =====================================================================

# هدایت HTTP → HTTPS برای دامنهٔ ریشه و ساب‌دامین‌ها
# (چالش ACME در مسیر /.well-known/acme-challenge مستثنی شده است.)
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ *.__DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type "text/plain";
        allow all;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__ *.__DOMAIN__;

    ssl_certificate     __TLS_CRT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:20m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root __SPA_DIST__;
    index index.html;
    client_max_body_size 40m;
    charset utf-8;
    server_tokens off;

    access_log /var/log/nginx/nobino.ssl.access.log;
    error_log  /var/log/nginx/nobino.ssl.error.log warn;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml image/svg+xml font/ttf font/otf;

    location /api/ {
        proxy_pass http://nobino_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 120s;
    }

    location /uploads/ {
        alias __UPLOADS__/;
        try_files $uri @nobino_backend_tls;
        expires 30d;
        add_header Cache-Control "public";
    }
    location /voice/ {
        alias __VOICE__/;
        try_files $uri @nobino_backend_tls;
        expires 7d;
    }
    location @nobino_backend_tls {
        proxy_pass http://nobino_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri @nobino_backend_tls;
    }
    location = /sw.js {
        add_header Cache-Control "no-store, max-age=0";
        types { application/javascript js; }
        try_files $uri @nobino_backend_tls;
    }
    location = /manifest.webmanifest {
        add_header Content-Type "application/manifest+json";
        add_header Cache-Control "public, max-age=300";
        try_files $uri @nobino_backend_tls;
    }

    location / {
        try_files $uri $uri/index.html $uri.html /index.html;
        add_header Cache-Control "no-cache";
    }
    location ~* \.(xml|txt)$ {
        try_files $uri @nobino_backend_tls;
        expires 1h;
    }

    location ~ /\. { deny all; }
    location ~ \.map$ { deny all; }
}
