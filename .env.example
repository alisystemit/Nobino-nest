# ══════════════════════════════════════════════════════════════════
#  Nobino — Environment Variables
#  Copy to .env and fill real values.
# ══════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nobino?schema=public"

# ─── Auth / JWT ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Session cookie Secure flag: true | false
# If empty, it's inferred automatically from X-Forwarded-Proto.
# Only set false when the site intentionally runs on HTTP (internal test).
AUTH_COOKIE_SECURE=""

# ─── App ───────────────────────────────────────────────────────────
APP_URL="http://localhost:5173"
# Public site domain (absolute URLs, sitemap, OG). In production use the same as APP_URL.
SITE_URL="http://localhost:5173"
# Root domain for subdomains
ROOT_DOMAIN="nobino.ir"
# Alias domains (same site on multiple domains, comma-separated; empty = no aliases)
EXTRA_DOMAINS=""
# Cron protection secret (for sending reminder SMS)
CRON_SECRET="replace-with-a-long-random-secret"
# Base URL for external cron (crontab / monitoring service) to call /api/cron routes.
# Internal cron jobs run with @nestjs/schedule; this is only needed for external cron with curl.
AUTOMATION_BASE_URL="http://localhost:3100"

# ─── SMS ───────────────────────────────────────────────────────────
# SMS driver: kavenegar | smsdotir | mock
SMS_PROVIDER="mock"
KAVENEGAR_API_KEY=""
SMSDOTIR_API_KEY=""
SMSDOTIR_SENDER=""

# ─── Voice AI (OpenAI Whisper / local model) ───────────────────────
# Driver: openai | mock
VOICE_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="whisper-1"

# ─── Local speech model (Shenava/sherpa-onnx) ──────────────────────
# Optional model path; empty = models/shenava-koochik-v1.0-sherpa-onnx
SHENAVA_MODEL_DIR=""
# ffmpeg path; empty = auto from models/.bin or ffmpeg in PATH
FFMPEG_PATH=""
# Auto prepare model+ffmpeg at boot/dev (0 = off)
AUTO_ASR="1"

# ─── AI Text (LLM) — env vars for the "AI" panel keys ─────────────
# Text service: openai | groq | deepseek | custom (empty = automatic)
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
AI_CUSTOM_API_KEY=""
AI_CUSTOM_BASE_URL=""

# ─── Payment Gateways ──────────────────────────────────────────────
# Default driver: sandbox (simulation) | zarinpal | mellat | ...
PAYMENT_DEFAULT_GATEWAY="sandbox"
# In sandbox mode (all gateways test without merchant codes)
PAYMENT_SANDBOX="true"
# Gateway callback URL — value must be complete and absolute (no ${...} expansion in .env).
# In production use your own domain.
PAYMENT_CALLBACK_BASE="https://nobino.ir/api/payments/callback"

# ─── Gateway: Zarinpal ──────────────────────────────────────────────
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# ─── Gateway: Mellat (BehPardakht) ──────────────────────────────────
MELLAT_TERMINAL_ID=""
MELLAT_USERNAME=""
MELLAT_PASSWORD=""
MELLAT_SANDBOX="true"

# ─── Gateway: Saman (Sepehr) ──────────────────────────────────────────
SAMAN_TERMINAL_ID=""
SAMAN_SANDBOX="true"

# ─── Gateway: Parsian ────────────────────────────────────────────────
PARSIAN_TERMINAL_ID=""
PARSIAN_USERNAME=""
PARSIAN_PASSWORD=""
PARSIAN_SANDBOX="true"

# ─── Gateway: Pasargad ───────────────────────────────────────────────
PASARGAD_TERMINAL_ID=""
PASARGAD_USERNAME=""
PASARGAD_PASSWORD=""
PASARGAD_SANDBOX="true"

# ─── Gateway: AsanPardakht ──────────────────────────────────────────────
ASANPARDASHT_MERCHANT_ID=""
ASANPARDASHT_CONFIG_ID=""
ASANPARDASHT_SANDBOX="true"

# ─── Gateway: IranKish ────────────────────────────────────────────────
IRANKISH_TERMINAL_ID=""
IRANKISH_MERCHANT_ID=""
IRANKISH_SHA_KEY=""
IRANKISH_SANDBOX="true"

# ─── Gateway: BehPardakht Mellat (alias) ─────────────────────────────
BEHPARDAKHT_MERCHANT_ID=""
BEHPARDAKHT_SANDBOX="true"

# ─── Gateway: Sadad (National Bank) ──────────────────────────────────
SADAD_TERMINAL_ID=""
SADAD_MERCHANT_ID=""
SADAD_SHA_KEY=""
SADAD_SANDBOX="true"

# ─── Gateway: MabnaKart ──────────────────────────────────────────────
MABNA_TERMINAL_ID=""
MABNA_MERCHANT_ID=""
MABNA_SHA_KEY=""
MABNA_SANDBOX="true"

# ─── Gateway: Cetab ───────────────────────────────────────────────────
CETAB_TERMINAL_ID=""
CETAB_MERCHANT_ID=""
CETAB_SHA_KEY=""
CETAB_SANDBOX="true"

# ─── Gateway: PardashtNet ────────────────────────────────────────────────
PARDASHTNET_MERCHANT_ID=""
PARDASHTNET_API_KEY=""
PARDASHTNET_SANDBOX="true"

# ─── Gateway: PSP / NextPay ────────────────────────────────────────────
PSP_MERCHANT_ID=""
PSP_API_KEY=""
PSP_SANDBOX="true"

# (key name is NEXTPAY_MERCHANT_ID; read as env.NEXTPAY_MERCHANT_ID in code)
NEXTPAY_MERCHANT_ID=""
NEXTPAY_API_KEY=""
NEXTPAY_SANDBOX="true"

# ─── Gateway: Vanak ─────────────────────────────────────────────
VANAK_TERMINAL_ID=""
VANAK_MERCHANT_ID=""
VANAK_USERNAME=""
VANAK_PASSWORD=""
VANAK_SANDBOX="true"

# ─── Gateways: PAYIR / IDPAY / AMANAT / ZIBAL ───────────────────────
# Each reads from the shared PSP_API_KEY / PSP_MERCHANT_ID above
# if no dedicated key is set (backend/src/lib/payments/gateways/*).
PAYIR_API_KEY=""
IDPAY_API_KEY=""
AMANAT_API_KEY=""
ZIBAL_API_KEY=""
ZIBAL_MERCHANT_ID=""

# ─── Blob / Storage (for voice and gallery) ─────────────────────────
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# (Sentry monitoring is not implemented in this version; keys defined here
# are not read, so they were removed — to add: connect @sentry/nestjs in main.ts.)

# ══════════════════════════════════════════════════════════════════
#  Deployment (server / PaaS) — Full guide: docs/deploy.md
# ══════════════════════════════════════════════════════════════════
# Internal API (and SPA when SERVE_FRONTEND) port. PaaS sets PORT itself.
PORT="3100"
HOST="0.0.0.0"
# 1 = backend also serves frontend/dist on this port (required for single-port PaaS)
SERVE_FRONTEND="1"
# Database preparation at boot: auto | migrate | push | skip
DB_SETUP="auto"
# Background prerender after boot: 0/1
PRERENDER_ON_BOOT="1"
# Demo seed at boot (scripts/paas-start.mjs): creates admin with default password,
# so it has no effect on NODE_ENV=production unless ALLOW_PROD_SEED=1
AUTO_SEED="0"
ALLOW_PROD_SEED="0"
# If SPA and API are hosted separately: comma-separated list of origins
# Empty = same-origin only (single-port). For separate domains: https://app.example.com
CORS_ORIGIN=""
# Request body size limits (bytes). Empty = default (JSON: 2MB, uploads: 110MB)
MAX_JSON_BODY_BYTES=""
MAX_UPLOAD_BODY_BYTES=""
# Show OTP code in production — disabled by default; only enable temporarily for testing
OTP_DISPLAY_ALLOW_PRODUCTION="0"
# Frontend build variables (Vite) — rebuild frontend after changing them
VITE_ROOT_DOMAIN="nobino.ir"
VITE_SITE_URL="https://nobino.ir"
VITE_APP_URL="https://nobino.ir"
