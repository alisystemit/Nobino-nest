# ══════════════════════════════════════════════════════════════════
#  Nobino — Environment Variables
#  Copy to .env and fill real values.
# ══════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nobino?schema=public"

# ─── Auth / JWT ────────────────────────────────────────────────────
# تولید با: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# پرچم Secure کوکی نشست: true | false
# اگر خالی بماند خودکار تشخیص داده می‌شود (از X-Forwarded-Proto).
# فقط وقتی false بگذارید که سایت عمداً روی HTTP سرویس می‌شود (تست داخلی).
AUTH_COOKIE_SECURE=""

# ─── App ───────────────────────────────────────────────────────────
APP_URL="http://localhost:5173"
# دامنهٔ عمومی سایت (لینک‌های مطلق، sitemap، OG). در پروداکشن همان APP_URL را بگذارید.
SITE_URL="http://localhost:5173"
# دامنه ریشه برای ساب‌دامین‌ها
ROOT_DOMAIN="nobino.ir"
# برای محافظت از آدرس Cron (ارسال پیامک یادآوری)
CRON_SECRET="replace-with-a-long-random-secret"
# آدرس پایه‌ای که کران خارجی (crontab / سرویس مانیتورینگ) مسیرهای /api/cron را
# روی آن صدا می‌زند. کران‌های داخلی خود اپ با @nestjs/schedule اجرا می‌شوند و
# این مقدار برای حالت «کران بیرونی با curl» لازم است.
AUTOMATION_BASE_URL="http://localhost:3100"

# ─── SMS ───────────────────────────────────────────────────────────
# درایور پیامک: kavenegar | smsdotir | mock
SMS_PROVIDER="mock"
KAVENEGAR_API_KEY=""
SMSDOTIR_API_KEY=""
SMSDOTIR_SENDER=""

# ─── Voice AI (OpenAI Whisper) ─────────────────────────────────────
# درایور: openai | mock
VOICE_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="whisper-1"

# ─── AI Text (LLM) — جایگزین env برای کلیدهای پنل «هوش مصنوعی» ────
# سرویس متن: openai | groq | deepseek | custom (خالی = خودکار)
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
AI_CUSTOM_API_KEY=""
AI_CUSTOM_BASE_URL=""

# ─── Payment Gateways ──────────────────────────────────────────────
# درایور پیش‌فرض: sandbox (شبیه‌سازی) | zarinpal | mellat | ...
PAYMENT_DEFAULT_GATEWAY="sandbox"
# در حالت sandbox (همه درگاه‌ها بدون مرچنت‌کد تست می‌شوند)
PAYMENT_SANDBOX="true"
# آدرس بازگشت درگاه — مقدار باید کامل و مطلق باشد (در .env جای‌نگهدار ${...}
# باز نمی‌شود). در پروداکشن دامنهٔ خودتان را بگذارید.
PAYMENT_CALLBACK_BASE="https://nobino.ir/api/payments/callback"

# ─── درگاه: زرین‌پال ────────────────────────────────────────────────
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# ─── درگاه: ملت (BehPardakht) ──────────────────────────────────────
MELLAT_TERMINAL_ID=""
MELLAT_USERNAME=""
MELLAT_PASSWORD=""
MELLAT_SANDBOX="true"

# ─── درگاه: سامان (Sepehr) ──────────────────────────────────────────
SAMAN_TERMINAL_ID=""
SAMAN_SANDBOX="true"

# ─── درگاه: پارسیان ────────────────────────────────────────────────
PARSIAN_TERMINAL_ID=""
PARSIAN_USERNAME=""
PARSIAN_PASSWORD=""
PARSIAN_SANDBOX="true"

# ─── درگاه: پاسارگاد ───────────────────────────────────────────────
PASARGAD_TERMINAL_ID=""
PASARGAD_USERNAME=""
PASARGAD_PASSWORD=""
PASARGAD_SANDBOX="true"

# ─── درگاه: آسان‌پرداخت ──────────────────────────────────────────────
ASANPARDASHT_MERCHANT_ID=""
ASANPARDASHT_CONFIG_ID=""
ASANPARDASHT_SANDBOX="true"

# ─── درگاه: ایران‌کیش ────────────────────────────────────────────────
IRANKISH_TERMINAL_ID=""
IRANKISH_MERCHANT_ID=""
IRANKISH_SHA_KEY=""
IRANKISH_SANDBOX="true"

# ─── درگاه: به‌پرداخت ملت (alias) ─────────────────────────────────────
BEHPARDAKHT_MERCHANT_ID=""
BEHPARDAKHT_SANDBOX="true"

# ─── درگاه: سداد (بانک ملی) ──────────────────────────────────────────
SADAD_TERMINAL_ID=""
SADAD_MERCHANT_ID=""
SADAD_SHA_KEY=""
SADAD_SANDBOX="true"

# ─── درگاه: مبناکارت ────────────────────────────────────────────────
MABNA_TERMINAL_ID=""
MABNA_MERCHANT_ID=""
MABNA_SHA_KEY=""
MABNA_SANDBOX="true"

# ─── درگاه: سی‌تاب ───────────────────────────────────────────────────
CETAB_TERMINAL_ID=""
CETAB_MERCHANT_ID=""
CETAB_SHA_KEY=""
CETAB_SANDBOX="true"

# ─── درگاه: پرداخت‌نت ────────────────────────────────────────────────
PARDASHTNET_MERCHANT_ID=""
PARDASHTNET_API_KEY=""
PARDASHTNET_SANDBOX="true"

# ─── درگاه: PSP / نکست‌پی ────────────────────────────────────────────
PSP_MERCHANT_ID=""
PSP_API_KEY=""
PSP_SANDBOX="true"

# (نام کلید NEXTPAY_MERCHANT_ID است؛ در کد با env.NEXTPAY_MERCHANT_ID خوانده می‌شود)
NEXTPAY_MERCHANT_ID=""
NEXTPAY_API_KEY=""
NEXTPAY_SANDBOX="true"

# ─── درگاه: ونکی (Vanak) ─────────────────────────────────────────────
VANAK_TERMINAL_ID=""
VANAK_MERCHANT_ID=""
VANAK_USERNAME=""
VANAK_PASSWORD=""
VANAK_SANDBOX="true"

# ─── Blob / Storage (برای صوت و گالری) ───────────────────────────────
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# Sentry (پایش خطا/عملکرد - اختیاری)
SENTRY_DSN=""
# (NEXT_PUBLIC_SENTRY_DSN مربوط به نسخهٔ Next.js بود و در این نسخه خوانده نمی‌شود)
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0"

# ══════════════════════════════════════════════════════════════════
#  استقرار (سرور / PaaS) — راهنمای کامل: docs/deploy.md
# ══════════════════════════════════════════════════════════════════
# پورت داخلی API (و SPA در حالت SERVE_FRONTEND). PaaS خودش PORT را ست می‌کند.
PORT="3100"
HOST="0.0.0.0"
# 1 = بک‌اند، frontend/dist را هم از همین پورت سرو کند (برای PaaS تک‌پورت لازم است)
SERVE_FRONTEND="1"
# آماده‌سازی دیتابیس هنگام بوت: auto | migrate | push | skip
DB_SETUP="auto"
# کران خلفی بعد از بوت: 0/1
PRERENDER_ON_BOOT="1"
# اگر SPA و API جدا از هم میزبانی می‌شوند: لیست مبدأ با کاما
CORS_ORIGIN=""
# متغیرهای build فرانت (Vite) — بعد از تغییر، فرانت را دوباره بسازید
VITE_ROOT_DOMAIN="nobino.ir"
VITE_SITE_URL="https://nobino.ir"
VITE_APP_URL="https://nobino.ir"
