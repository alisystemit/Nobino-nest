// Nobino ΓÇö Prisma Schema
// PostgreSQL database. Model covers multi-tenant salons, voice AI,
// OTP auth, finance (wallet/commission/payout) and payments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ΓöÇΓöÇΓöÇ Enums ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

enum Role {
  CUSTOMER // ┘à╪┤╪¬╪▒█î
  SALON_OWNER // ╪ó╪▒╪º█î╪┤┌»╪▒ / ╪╡╪º╪¡╪¿ ╪│╪º┘ä┘å
  AGENT // ┘å┘à╪º█î┘å╪»┘ç (┌⌐┘à█î╪│█î┘ê┘å ╪»╪▒╪╡╪»█î)
  ADMIN // ╪│┘ê┘╛╪▒╪º╪»┘à█î┘å
}

enum AppointmentStatus {
  REQUESTED // ╪»╪▒ ╪º┘å╪¬╪╕╪º╪▒ ╪¬╪ú█î█î╪»
  CONFIRMED // ╪¬╪ú█î█î╪» ╪┤╪»┘ç
  COMPLETED // ╪º┘å╪¼╪º┘à ╪┤╪»┘ç
  CANCELLED // ┘ä╪║┘ê ╪┤╪»┘ç
  NO_SHOW // ┘à╪▒╪º╪¼╪╣┘ç ┘å┌⌐╪▒╪»
}

enum CreationChannel {
  VOICE // ╪╢╪¿╪╖ ╪╡┘ê╪¬█î/┘ç┘ê╪┤ ┘à╪╡┘å┘ê╪╣█î
  MANUAL // ╪½╪¿╪¬ ╪»╪│╪¬█î
  WEBAPP // ┘ê╪¿ΓÇî╪º┘╛ ┘╛█î╪º┘àΓÇî╪▒╪│╪º┘å
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum TransactionKind {
  CREDIT // ╪º┘ü╪▓╪º█î╪┤ ┘à┘ê╪¼┘ê╪»█î
  DEBIT // ┌⌐╪º┘ç╪┤ ┘à┘ê╪¼┘ê╪»█î
}

enum TransactionReason {
  PACKAGE_PURCHASE
  COMMISSION_EARNING
  COMMISSION_PAYOUT
  PAYOUT
  REFUND
  ADMIN_ADJUSTMENT
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// ΓöÇΓöÇΓöÇ User & Auth ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  name          String?
  email         String?   @unique
  avatarUrl     String?
  role          Role      @default(CUSTOMER)
  passwordHash  String?
  verifiedAt    DateTime?
  isActive      Boolean   @default(true)
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // relations
  ownedSalons     Salon[]          @relation("SalonOwner")
  votes           Appointment[]    @relation("AppointmentCustomer")
  wallets         Wallet[]
  orders          Order[]
  sessions        Session[]
  commissionPlans CommissionPlan[] @relation("AgentPlan")
  favorites       Favorite[]
  reviews         Review[]         @relation("ReviewCustomer")
  giftCards       GiftCard[]
  staffAccounts   Staff[]          @relation("StaffUser")
  supportTickets  SupportTicket[]   @relation("SupportTickets")
}

model Otp {
  id        String    @id @default(cuid())
  phone     String
  code      String
  purpose   String    @default("LOGIN") // LOGIN | VERIFY | EMAIL_LOGIN
  attempts  Int       @default(0) // ╪¬╪╣╪»╪º╪» ╪¬┘ä╪º╪┤ΓÇî┘ç╪º█î ┘å╪º┘à┘ê┘ü┘é ╪¿╪▒╪º█î ╪º█î┘å ┌⌐╪»
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, purpose])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  device    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ΓöÇΓöÇΓöÇ Salon (multi-tenant) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Salon {
  id                 String    @id @default(cuid())
  slug               String    @unique // ╪│╪º╪¿ΓÇî╪»╪º┘à█î┘å
  name               String
  phone              String
  city               String?
  address            String?
  description        String?

  // ╪¬┘à╪º╪│ ┘ê ┘à┘ê┘é╪╣█î╪¬ (┘ü╪▒┘à ╪│╪º╪«╪¬/┘ê█î╪▒╪º█î╪┤ ╪│╪º┘ä┘å)
  email              String?
  whatsapp           String? // ┘ü┘é╪╖ ╪▒┘é┘à╪î ╪¿╪▒╪º█î ┘ä█î┘å┌⌐ wa.me
  instagram          String? // @handle █î╪º URL ┌⌐╪º┘à┘ä
  website            String?
  mapUrl             String? // ┘ä█î┘å┌⌐ ┘à┘ê┘é╪╣█î╪¬ ╪»╪▒ ╪¿┘ä╪»/┘å╪┤╪º┘å (┘à┘å╪¿╪╣ ╪»┌⌐┘à┘ç┘ö ┘à╪│█î╪▒█î╪º╪¿█î)
  neshanUrl          String? // لینک موقعیت در «نشان»
  baladUrl           String? // لینک موقعیت در «بلد»

  logoUrl            String?
  bannerUrl          String?
  coverColor         String    @default("#f472b6")
  timezone           String    @default("Asia/Tehran")
  latitude           Float?
  longitude          Float?
  customDomain       String?   @unique
  domainStatus       String    @default("NONE") // NONE | PENDING | VERIFIED
  domainToken        String?
  isApproved         Boolean   @default(false)
  isActive           Boolean   @default(true)
  subscriptionEndsAt DateTime?
  trialEndsAt        DateTime?
  autoRenew          Boolean   @default(false)
  plan               String    @default("FREE") // FREE | BASIC | PRO | ENTERPRISE

  // ┘é┘ê╪º┘å█î┘å ╪▒╪▓╪▒┘ê
  minNoticeMinutes    Int @default(60)
  maxAdvanceDays      Int @default(30)
  cancelDeadlineHours Int @default(24)
  bufferMinutes       Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  services        Service[]
  appointments    Appointment[]
  voiceCalls      VoiceCall[]
  galleryItems    GalleryItem[]
  openingHours    OpeningHour[]
  subscriptions   Subscription[]
  commissionPlans CommissionPlan[]
  orders          Order[]
  staff           Staff[]
  timeBlocks      TimeBlock[]
  reviews         Review[]
  holidays        Holiday[]
  favorites       Favorite[]
  waitlist        WaitlistEntry[]     @relation("WaitlistSalon")
  webhooks        WebhookConfig[]     @relation("WebhookSalon")
  branches        Branch[]
  cashEntries     CashRegisterEntry[]
  customers       SalonCustomer[]
  invoices        Invoice[]
  campaigns       Campaign[]
  customerMedia   SalonCustomerMedia[]

  // █î┌⌐ ┌⌐╪º╪▒╪¿╪▒ ┘à█îΓÇî╪¬┘ê╪º┘å╪» ┌å┘å╪» ╪│╪º┘ä┘å ╪»╪º╪┤╪¬┘ç ╪¿╪º╪┤╪» (╪│┘é┘ü ┬½╪¬╪╣╪»╪º╪» ╪│╪º┘ä┘å ┘ç╪▒ ┌⌐╪º╪▒╪¿╪▒┬╗ ╪»╪▒ ┘╛┘ä┘åΓÇî┘ç╪º ╪º╪╣┘à╪º┘ä ┘à█îΓÇî╪┤┘ê╪»)
  @@index([ownerId])
}

// ΓöÇΓöÇΓöÇ CRM ┘à╪┤╪¬╪▒█î╪º┘å ┘ç╪▒ ╪│╪º┘ä┘å ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model SalonCustomer {
  id          String              @id @default(cuid())
  salonId     String
  salon       Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  phone       String
  name        String?
  firstName    String?
  lastName     String?
  note        String?
  visits      Int                 @default(0)
  spend       Int                 @default(0)
  lastVisitAt DateTime?
  tags        String[]            @default([])
  notes       SalonCustomerNote[]
  media       SalonCustomerMedia[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([salonId, phone])
  @@index([salonId])
}

model SalonCustomerNote {
  id         String        @id @default(cuid())
  customerId String
  customer   SalonCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  note       String
  createdAt  DateTime      @default(now())

  @@index([customerId])
}

model SalonCustomerMedia {
  id         String       @id @default(cuid())
  salonId    String
  salon      Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId String
  customer   SalonCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String       @default("photo") // photo | voice
  url        String
  name       String?
  mimeType   String?
  size       Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([customerId])
  @@index([salonId])
}

// ΓöÇΓöÇΓöÇ ╪┤╪╣╪¿┘ç (┌å┘å╪» ╪┤╪╣╪¿┘ç ╪¿╪▒╪º█î █î┌⌐ ╪│╪º┘ä┘å/╪¿╪▒┘å╪») ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Branch {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff        Staff[]
  services     Service[]
  appointments Appointment[]
  timeBlocks   TimeBlock[]
  cashEntries  CashRegisterEntry[]
  holidays     Holiday[]

  @@index([salonId])
}

// ΓöÇΓöÇΓöÇ ╪╡┘å╪»┘ê┘é / ╪¬╪│┘ê█î┘ç ╪▒┘ê╪▓╪º┘å┘ç ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model CashRegisterEntry {
  id            String   @id @default(cuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  date          DateTime @default(now())
  cashAmount    Int      @default(0) // ┘å┘é╪»█î
  cardAmount    Int      @default(0) // ┌⌐╪º╪▒╪¬ΓÇî╪«┘ê╪º┘å
  onlineAmount  Int      @default(0) // ╪ó┘å┘ä╪º█î┘å
  expenseAmount Int      @default(0) // ┘ç╪▓█î┘å┘ç
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([salonId, date])
}

model Service {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  name        String
  durationMin Int
  price       Int
  description String?
  category    String?
  bufferMin   Int      @default(0)
  steps       Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  appointments Appointment[]
  staff        Staff[]

  @@index([salonId])
}

model GalleryItem {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  title     String?
  imageUrl  String
  type      String   @default("image") // image | video
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([salonId])
}

model OpeningHour {
  id        String  @id @default(cuid())
  salonId   String
  salon     Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0..6 (╪┤┘å╪¿┘ç = 0)
  openTime  String // "09:00"
  closeTime String // "21:00"
  isClosed  Boolean @default(false)

  @@unique([salonId, dayOfWeek])
}

model Holiday {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  date      DateTime
  isClosed  Boolean  @default(true)
  openTime  String?
  closeTime String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([salonId, date])
}

// ΓöÇΓöÇΓöÇ Appointments & Voice AI ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Appointment {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  customerId String?
  customer   User?   @relation("AppointmentCustomer", fields: [customerId], references: [id])

  // ╪ó╪▒╪º█î╪┤┌»╪▒ ╪º┘å╪¬╪«╪º╪¿ΓÇî╪┤╪»┘ç (╪º╪«╪¬█î╪º╪▒█î)
  employeeId String?
  employee   Staff?  @relation(fields: [employeeId], references: [id])
  branchId   String?
  branch     Branch? @relation(fields: [branchId], references: [id])

  customerName      String
  customerPhone     String
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus @default(REQUESTED)
  channel           CreationChannel   @default(MANUAL)
  note              String?
  cancelReason      String?
  cancelledAt       DateTime?
  depositAmount     Int? // ┘╛█î╪┤ΓÇî┘╛╪▒╪»╪º╪«╪¬/╪¿█î╪╣╪º┘å┘ç (╪¬┘ê┘à╪º┘å)
  depositPaid       Boolean           @default(false)
  tempLockExpiresAt DateTime? // ┘é┘ü┘ä ┘à┘ê┘é╪¬ ┘ç┘å┌»╪º┘à ┘╛╪▒╪»╪º╪«╪¬
  rescheduledFrom   String? // id ┘å┘ê╪¿╪¬ ┘é╪¿┘ä█î ┘ç┘å┌»╪º┘à ╪¼╪º╪¿┘çΓÇî╪¼╪º█î█î
  voiceCallId       String?           @unique
  voiceCall         VoiceCall?        @relation(fields: [voiceCallId], references: [id])
  review            Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId, startAt])
  @@index([employeeId])
  @@index([customerPhone])
}

model VoiceCall {
  id          String       @id @default(cuid())
  salonId     String
  salon       Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  audioUrl    String?
  durationSec Int?
  transcript  String? // ┘à╪¬┘å ╪º╪│╪¬╪«╪▒╪º╪¼ΓÇî╪┤╪»┘ç
  rawText     String? // ┘à╪¬┘å ╪«╪º┘à ┘╛█î╪┤ ╪º╪▓ ┘╛╪▒╪»╪º╪▓╪┤
  extracted   Json? // ╪º╪╖┘ä╪º╪╣╪º╪¬ ┘å┘ê╪¿╪¬ ╪º╪│╪¬╪«╪▒╪º╪¼ΓÇî╪┤╪»┘ç
  status      String       @default("PROCESSING") // PROCESSING | DONE | FAILED | CONFIRMED
  error       String?
  appointment Appointment?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([salonId])
}

// ΓöÇΓöÇΓöÇ Financial: Wallet / Transaction / Commission / Payout ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Wallet {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // ╪¬┘ê┘à╪º┘å
  currency  String   @default("IRR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  payouts      Payout[]

  @@unique([ownerId])
}

model Transaction {
  id           String            @id @default(cuid())
  walletId     String
  wallet       Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  kind         TransactionKind
  reason       TransactionReason
  amount       Int // ┘ç┘à█î╪┤┘ç ┘à╪½╪¿╪¬╪¢ ╪¼┘ç╪¬ ╪¬┘ê╪│╪╖ kind ┘à╪┤╪«╪╡ ┘à█îΓÇî╪┤┘ê╪»
  balanceAfter Int
  refType      String? // Order | Appointment | Payout
  refId        String?
  description  String?
  createdAt    DateTime          @default(now())

  @@index([walletId])
}

model CommissionPlan {
  id        String   @id @default(cuid())
  agentId   String
  agent     User     @relation("AgentPlan", fields: [agentId], references: [id], onDelete: Cascade)
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  percent   Float // 0..100
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([agentId, salonId])
}

model Payout {
  id          String       @id @default(cuid())
  walletId    String
  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Int
  method      String       @default("BANK") // BANK | CARD | SMS
  bankInfo    String?
  status      PayoutStatus @default(REQUESTED)
  requestedAt DateTime     @default(now())
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([walletId])
}

// ΓöÇΓöÇΓöÇ Packages, Subscriptions, Orders & Payments ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

model Package {
  id           String   @id @default(cuid())
  name         String
  description  String?
  plan         String   @default("BASIC") // FREE | BASIC | PRO | ENTERPRISE
  price        Int // ╪¬┘ê┘à╪º┘å (┘à╪º┘ç╪º┘å┘ç)
  yearlyPrice  Int? // ╪¬┘ê┘à╪º┘å ╪»╪▒ ╪│╪º┘ä (╪º┌»╪▒ ╪«╪º┘ä█î ╪¿╪º╪┤╪» = price * 10)
  durationDays Int
  features     Json? // ╪ó╪▒╪º█î┘çΓÇî╪º█î ╪º╪▓ ╪º┘à┌⌐╪º┘å╪º╪¬
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
  orders        Order[]
}

model Subscription {
  id          String    @id @default(cuid())
  salonId     String
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  packageId   String
  package     Package   @relation(fields: [packageId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  period      String    @default("MONTHLY") // MONTHLY | YEARLY
  autoRenew   Boolean   @default(false)
  status      String    @default("ACTIVE") // ACTIVE | SUSPENDED | CANCELLED | EXPIRED
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  invoices    Invoice[]

  @@index([salonId])
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  salonId        String
  salon          Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  orderId        String?       @unique
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind           String        @default("SUBSCRIPTION") // SUBSCRIPTION | SERVICE (┘ü╪º┌⌐╪¬┘ê╪▒ ╪«╪»┘à╪º╪¬█î ╪¿╪▒╪º█î ┘à╪┤╪¬╪▒█î)
  customerName   String?
  customerPhone  String?
  description    String?
  payToken       String?       @unique
  amount         Int
  originalAmount Int?
  period         String        @default("MONTHLY")
  status         PaymentStatus @default(PENDING)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments Payment[]

  @@index([salonId])
  @@index([subscriptionId])
}

model Campaign {
  id          String    @id @default(cuid())
  salonId     String
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  channel     String    @default("SMS") // SMS | EMAIL
  segment     String    @default("ALL") // ALL | RETURNING
  message     String
  status      String    @default("DRAFT") // DRAFT | SENT | SCHEDULED
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([salonId])
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId        String?
  salon          Salon?        @relation(fields: [salonId], references: [id])
  packageId      String
  package        Package       @relation(fields: [packageId], references: [id])
  discountId     String?
  discount       Discount?     @relation(fields: [discountId], references: [id])
  amount         Int // ┘à╪¿┘ä╪║ ┘å┘ç╪º█î█î ┘╛╪│ ╪º╪▓ ╪¬╪«┘ü█î┘ü
  originalAmount Int? // ┘╛█î╪┤ ╪º╪▓ ╪¬╪«┘ü█î┘ü
  period         String        @default("MONTHLY") // MONTHLY | YEARLY
  autoRenew      Boolean       @default(false)
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments Payment[]
  invoice  Invoice?
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  gateway     String // zarinpal | mellat | ...
  amount      Int
  status      PaymentStatus @default(PENDING)
  authority   String? // ┌⌐╪» ┘à╪▒╪¼╪╣ ╪»╪▒┌»╪º┘ç
  refId       String? // ┌⌐╪» ┘╛█î┌»█î╪▒█î ╪¬╪▒╪º┌⌐┘å╪┤
  cardPan     String?
  payload     Json?
  callbackUrl String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([invoiceId])
  @@index([gateway])
}

// ΓöÇΓöÇΓöÇ ┌⌐╪º╪▒╪¬ ┘ç╪»█î┘ç / ╪¿╪│╪¬┘ç ╪«╪»┘à╪º╪¬ ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model GiftCard {
  id        String    @id @default(cuid())
  code      String    @unique
  balance   Int // ╪¬┘ê┘à╪º┘å
  currency  String    @default("IRR")
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  salonId   String? // ╪º┌»╪▒ ┘ü┘é╪╖ ╪¿╪▒╪º█î █î┌⌐ ╪│╪º┘ä┘å ┘à╪╣╪¬╪¿╪▒ ╪º╪│╪¬
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
}

// ΓöÇΓöÇΓöÇ ┘ä█î╪│╪¬ ╪º┘å╪¬╪╕╪º╪▒ ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model WaitlistEntry {
  id            String    @id @default(cuid())
  salonId       String
  salon         Salon     @relation("WaitlistSalon", fields: [salonId], references: [id], onDelete: Cascade)
  employeeId    String?
  serviceId     String?
  customerName  String
  customerPhone String
  note          String?
  status        String    @default("WAITING") // WAITING | NOTIFIED | BOOKED | EXPIRED
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([salonId, status])
}

// ΓöÇΓöÇΓöÇ ┘ê╪¿ΓÇî┘ç┘ê┌⌐ (╪º╪▒╪│╪º┘ä ╪▒┘ê█î╪»╪º╪» ╪¿┘ç URL ┘à╪┤╪¬╪▒█î) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model WebhookConfig {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation("WebhookSalon", fields: [salonId], references: [id], onDelete: Cascade)
  url       String
  secret    String?
  events    String[] // ["appointment.confirmed","appointment.cancelled",...]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([salonId])
}

model WebhookDelivery {
  id             String        @id @default(cuid())
  configId       String
  config         WebhookConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  event          String
  payload        Json?
  status         String        @default("PENDING") // PENDING | SUCCESS | FAILED
  responseStatus Int?
  attempts       Int           @default(0)
  lastError      String?
  createdAt      DateTime      @default(now())

  @@index([status])
}

// ΓöÇΓöÇΓöÇ ┌⌐╪» ╪¬╪«┘ü█î┘ü ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Discount {
  id        String    @id @default(cuid())
  code      String    @unique
  percent   Int // 1..100
  maxUses   Int       @default(0) // 0 = ┘å╪º┘à╪¡╪»┘ê╪»
  usedCount Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  orders Order[]
}

// ΓöÇΓöÇΓöÇ ┘ä╪º┌» ╪¡╪│╪º╪¿╪▒╪│█î (╪º┘é╪»╪º┘à╪º╪¬ ┘à╪»█î╪▒╪º┘å/┘╛╪┤╪¬█î╪¿╪º┘å█î) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorPhone String?
  action     String // approve_salon | suspend_salon | settings_update | support_login | ...
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ΓöÇΓöÇΓöÇ System Settings (┘╛┘ê█î╪º╪î ┘é╪º╪¿┘ä ┘ê█î╪▒╪º█î╪┤ ╪¬┘ê╪│╪╖ ╪│┘ê┘╛╪▒╪º╪»┘à█î┘å) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// ╪¿╪▒╪º█î ╪░╪«█î╪▒┘ç API_KEY┘ç╪º╪î ╪º┘å╪¬╪«╪º╪¿ ╪│╪▒┘ê█î╪│ΓÇî╪»┘ç┘å╪»┘ç ┘ü╪╣╪º┘ä ┘ê ┘ç╪▒ ╪¬┘å╪╕█î┘à ╪»█î┌»╪▒.
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique // ┘à╪½┘ä sms.active_provider
  value       String? // ┘à┘é╪»╪º╪▒ (╪¿╪▒╪º█î secret ╪¿╪º isSecret=true)
  group       String   @default("general")
  type        String   @default("string") // string | secret | number | boolean | select
  options     String? // ╪¿╪▒╪º█î type=select: ┘ä█î╪│╪¬ JSON
  description String?
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ΓöÇΓöÇΓöÇ ┌⌐╪º╪▒┌⌐┘å╪º┘å / ╪ó╪▒╪º█î╪┤┌»╪▒╪º┘å (Staff) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Staff {
  id       String  @id @default(cuid())
  salonId  String
  salon    Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  name              String
  title             String? // ┘à╪½┘ä ┬½╪ó╪▒╪º█î╪┤┌»╪▒ ╪º╪▒╪┤╪»┬╗
  role              String   @default("STYLIST") // OWNER | MANAGER | RECEPTION | STYLIST
  commissionPercent Int      @default(0) // ╪│┘ç┘à ╪ó╪▒╪º█î╪┤┌»╪▒ ╪º╪▓ ┘ç╪▒ ╪«╪»┘à╪¬ (┘¬)
  userId            String? // ╪¡╪│╪º╪¿ ┌⌐╪º╪▒╪¿╪▒█î ┘à╪▒╪¬╪¿╪╖ ╪¿╪▒╪º█î ┘╛╪▒╪»╪º╪«╪¬ ┌⌐┘à█î╪│█î┘ê┘å
  user              User?    @relation("StaffUser", fields: [userId], references: [id])
  bio               String?
  avatarUrl         String?
  specialties       String[] // ┘ä█î╪│╪¬ ╪¬╪«╪╡╪╡ΓÇî┘ç╪º
  isActive          Boolean  @default(true)

  // ╪¿╪▒┘å╪º┘à┘ç ┌⌐╪º╪▒█î ┘ç┘ü╪¬┌»█î: ╪ó╪▒╪º█î┘çΓÇî╪º█î ╪º╪▓ { day, open, close, isClosed }
  schedule Json?

  services     Service[]
  appointments Appointment[]
  timeBlocks   TimeBlock[]
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salonId])
}

// ΓöÇΓöÇΓöÇ ┘à╪│╪»┘ê╪»╪│╪º╪▓█î ╪▓┘à╪º┘å (┘å╪º┘ç╪º╪▒╪î ╪¬╪╣┘à█î╪▒╪º╪¬╪î ┘à╪▒╪«╪╡█î╪î...) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model TimeBlock {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id])
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([salonId, startAt])
  @@index([staffId])
}

// ΓöÇΓöÇΓöÇ ┘å╪╕╪▒╪º╪¬ ┘ê ╪º┘à╪¬█î╪º╪▓┘ç╪º ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Review {
  id            String       @id @default(cuid())
  salonId       String
  salon         Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staffId       String?
  staff         Staff?       @relation(fields: [staffId], references: [id])
  customerId    String
  customer      User         @relation("ReviewCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  rating        Int // 1..5
  comment       String?
  reply         String? // ┘╛╪º╪│╪« ╪│╪º┘ä┘åΓÇî╪»╪º╪▒ / ╪│┘ê┘╛╪▒╪º╪»┘à█î┘å ╪¿┘ç ┘å╪╕╪▒
  repliedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([salonId])
  @@index([customerId])
}

// ΓöÇΓöÇΓöÇ ╪╣┘ä╪º┘é┘çΓÇî┘à┘å╪»█îΓÇî┘ç╪º (╪│╪º┘ä┘åΓÇî┘ç╪º█î ┘à╪¡╪¿┘ê╪¿) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, salonId])
}

// ΓöÇΓöÇΓöÇ ┘╛╪┤╪¬█î╪¿╪º┘å█î ┘ê ╪┤┌⌐╪º█î╪¬ΓÇî┘ç╪º ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model SupportTicket {
  id          String              @id @default(cuid())
  userId      String?
  user        User?               @relation("SupportTickets", fields: [userId], references: [id], onDelete: SetNull)
  name        String
  phone       String
  email       String?
  category    String              @default("GENERAL") // GENERAL | BOOKING | PAYMENT | TECHNICAL | COMPLAINT
  subject     String
  message     String
  status      SupportTicketStatus @default(OPEN)
  priority    String              @default("NORMAL") // LOW | NORMAL | HIGH
  adminReply  String?
  repliedAt   DateTime?
  repliedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// ΓöÇΓöÇΓöÇ ╪╡┘ü ┘╛█î╪º┘à┌⌐/╪º╪╣┘ä╪º┘å (╪¿╪º ╪¬┘ä╪º╪┤ ┘à╪¼╪»╪» ┘ê ╪¡╪░┘ü ╪¬┌⌐╪▒╪º╪▒█î) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Notification {
  id            String    @id @default(cuid())
  type          String // OTP | APPOINTMENT_CONFIRM | REMINDER | CANCEL | SUBSCRIPTION
  channel       String    @default("SMS")
  recipient     String
  userId        String?
  salonId       String? // ╪│╪º┘ä┘å█î ┌⌐┘ç ┘╛█î╪º┘à┌⌐ ╪▒╪º ┘à╪╡╪▒┘ü ┘à█îΓÇî┌⌐┘å╪» (╪¿╪▒╪º█î ╪┤┘à╪º╪▒╪┤ ╪│┘é┘ü ┘╛█î╪º┘à┌⌐ ┘à╪º┘ç╪º┘å┘ç)
  readAt        DateTime? // ╪┤┘à╪º╪▒┘ç █î╪º ╪º█î┘à█î┘ä
  payload       Json?
  uniqueKey     String?   @unique // ╪¿╪▒╪º█î ╪¼┘ä┘ê┌»█î╪▒█î ╪º╪▓ ╪º╪▒╪│╪º┘ä ╪¬┌⌐╪▒╪º╪▒█î
  status        String    @default("PENDING") // PENDING | SENT | FAILED | DROPPED
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([salonId, channel, createdAt])
}
