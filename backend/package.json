{
  "name": "nobino-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nobino backend — NestJS",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:generate": "node ../node_modules/prisma/build/index.js generate --schema ../prisma/schema.prisma",
    "db:migrate": "node ../node_modules/prisma/build/index.js migrate dev --schema ../prisma/schema.prisma",
    "db:push": "node ../node_modules/prisma/build/index.js db push --schema ../prisma/schema.prisma",
    "verify": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/schedule": "^6.1.0",
    "@vercel/blob": "^2.8.2",
    "clsx": "^2.1.1",
    "jose": "^6.2.13",
    "nodemailer": "^10.1.7",
    "passport-jwt": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/pg": "^8.11.10",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2"
  }
}
