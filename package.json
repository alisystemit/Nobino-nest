{
  "name": "nobino-nest",
  "version": "0.1.0",
  "private": true,
  "description": "Nobino — خط NestJS: بک‌اند NestJS 11 (backend/) + فرانت React/Vite (frontend/)؛ schema و کلاینت Prisma در ریشه به‌صورت مشترک",
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "seed": "node prisma/seed.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:real": "node scripts/seed-real.mjs",
    "seed:real:dry": "node scripts/seed-real.mjs --dry-run",
    "seed:stress": "node scripts/seed-stress.mjs",
    "asr:model": "node scripts/download-asr-model.mjs",
    "asr:setup": "node scripts/asr-setup.mjs",
    "asr:check": "node scripts/check-asr.mjs",
    "gen:controllers": "node backend/scripts/gen-controllers.mjs",
    "build:backend": "npm --prefix backend run build",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "node scripts/dev-start.mjs",
    "dev:fast": "node scripts/dev-start-fast.mjs",
    "stop": "node scripts/dev-stop.mjs",
    "build": "node scripts/build-release.mjs --skip-install --no-smoke",
    "build:release": "node scripts/build-release.mjs",
    "start": "node scripts/paas-start.mjs",
    "test": "node --test \"scripts/*.test.mjs\"",
    "test:wiring": "node --test scripts/wiring.test.mjs",
    "test:smoke": "node --test scripts/smoke.test.mjs",
    "test:seo": "node --test scripts/seo.test.mjs",
    "test:deploy": "node --test scripts/deploy-update.test.mjs",
    "test:backups": "node --test scripts/backups.test.mjs",
    "verify": "npm run db:generate && npm run build:backend && npm run build:frontend && npm test"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
